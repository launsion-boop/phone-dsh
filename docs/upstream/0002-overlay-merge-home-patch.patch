--- /dev/null
+++ b/packages/experimental/webworker-packer/tests/overlay-home-patch.spec.ts
@@ -0,0 +1,52 @@
+/**
+ * An overlay that ships its own `home/cordis.patch.yml` replaces the base
+ * image's home-patch file when the Worker applies it. Packing the overlay with
+ * the platform rows the image carries merges the two lists instead: the
+ * overlay's rows come first and the platform's last, so a same-id row keeps the
+ * platform config the Worker requires.
+ */
+import { mkdtempSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { describe, expect, it } from 'vitest'
+import yaml from 'js-yaml'
+import { entryListSchema } from '@deepseek-ai/cordis-plugin-include'
+import { HOME_PATCH_PATH, packVfsOverlay } from '../src/pack.ts'
+
+/** The row shape the packer writes to the image's home patch. */
+const platformRows = [{
+  id: 'session-persistence-jsonl',
+  config: { root: { __jsExpr: "dshHomePath('sessions')" }, compression: 'none' },
+}]
+
+describe('overlay home patch', () => {
+  it('merges the overlay rows with the platform rows instead of replacing them', (test) => {
+    const directory = mkdtempSync(join(tmpdir(), 'dsh-overlay-home-patch-'))
+    test.onTestFinished(() => { rmSync(directory, { recursive: true, force: true }) })
+    writeFileSync(join(directory, 'cordis.patch.yml'), [
+      '- id: overlay-row',
+      '  config:',
+      '    answer: 42',
+      '- id: session-persistence-jsonl',
+      '  config:',
+      '    root: !!js dshHomePath("sessions")',
+      '    compression: zstd',
+      '',
+    ].join('\n'))
+
+    const { files } = packVfsOverlay([{ mount: 'home', directory }], { platformHomePatch: platformRows })
+    expect(HOME_PATCH_PATH).toBe('home/cordis.patch.yml')
+    const merged = yaml.load(new TextDecoder().decode(files[HOME_PATCH_PATH]), { schema: entryListSchema })
+    expect(merged).toEqual([
+      { id: 'overlay-row', config: { answer: 42 } },
+      { id: 'session-persistence-jsonl', config: { root: { __jsExpr: 'dshHomePath("sessions")' }, compression: 'zstd' } },
+      ...platformRows,
+    ])
+    // Later rows win a same-id replacement, so the platform's plaintext
+    // compression survives an overlay that restates the row.
+    const compression = (merged as { id?: string; config?: { compression?: string } }[])
+      .filter(row => row.id === 'session-persistence-jsonl')
+      .at(-1)?.config?.compression
+    expect(compression).toBe('none')
+  })
+})

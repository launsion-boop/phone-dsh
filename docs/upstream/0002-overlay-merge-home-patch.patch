+  const overlayPatch = files[HOME_PATCH_PATH]
+  const platformRows = options.platformHomePatch ?? []
+  if (overlayPatch !== undefined && platformRows.length > 0) {
+    const rows: unknown = yaml.load(new TextDecoder().decode(overlayPatch), { schema: entryListSchema })

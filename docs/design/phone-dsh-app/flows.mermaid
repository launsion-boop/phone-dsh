flowchart TD
  subgraph F1["F1 首次启动与 Personal Agent 渐进配置"]
    A1[默认进入 DSH] --> A2[可新建任务、查看会话和产物]
    A1 --> A3[打开 Personal Agent Chat]
    A3 --> A4{Personal Agent 已配置吗}
    A4 -->|否| A5[显示 needsApiKey，不伪装个性化回答]
    A4 -->|是| A12[进入个性化 Chat]
    A5 --> A6{选择 Provider 并配置 API key}
    A6 -->|Tono 托管| A7[显示云端路径与 Credits]
    A6 -->|BYOK / 自建| A8[Key 只存手机 Keychain]
    A7 --> A9[Mock 验证通过]
    A8 --> A9
    A9 --> A10[输入 Agent 名]
    A10 --> A11[输入主人称呼]
    A11 --> A12
    A12 --> A13[Dock 增加 AI日记]
    A6 -->|失败| A14[留在配置页修正或稍后使用 DSH]
  end

  subgraph F2["F2 Personal Agent 或 DSH 到同一 TaskRun"]
    B1{入口}
    B1 -->|Personal Agent 输入| B2[Main 先保存输入与当前意图]
    B1 -->|DSH 新建任务| B5[直接创建通用 TaskRun]
    B2 --> B3{需要深执行吗}
    B3 -->|否| B4[轻量回答或固定服务]
    B3 -->|是| B5
    B5 --> B6[显示步骤、等待与取消]
    B6 --> B7{需要外部动作吗}
    B7 -->|否| B8[校验产物与来源]
    B7 -->|是| F5A[进入确认卡]
    F5A --> B8
    B8 --> B9{业务结果是否成立}
    B9 -->|完成| B10[保存本地产物并投影到 AI日记]
    B9 -->|失败| B11[保留检查点和可恢复错误]
    B9 -->|结果未知| B12[先对账，不自动重试]
  end

  subgraph F3["F3 实时或事后录音到日记与 Memory"]
    C1[AI日记连接麦克风或导入音频] --> C2[EvidenceWriter 保存原始证据]
    C2 --> C3[唯一 TranscriptionCoordinator]
    C3 --> C4[同一份 FINAL 与修订]
    C4 --> C5{是当前且获授权的语音吗}
    C5 -->|是| C6[Main 决定忽略、回答或委派]
    C5 -->|否或历史材料| C7[不当作当前指令]
    C4 --> C8[Recap 生成日记与会议纪要]
    C4 --> C9[个人 Memory 只生成候选]
    C9 --> C10{用户确认}
    C10 -->|确认或修改| C11[成为可用于回答的记忆]
    C10 -->|驳回或忘记| C12[不再进入新上下文]
    C6 --> C8
    C8 --> C13[摘要可回到原话与覆盖缺口]
  end

  subgraph F4["F4 BLE 配对、能力与反向控制"]
    F4A[从 Chat、AI日记或发现进入] --> D2[扫描并核对设备]
    D2 --> D3{用户在配对窗口确认}
    D3 -->|拒绝或超时| D4[不绑定，可重新扫描]
    D3 -->|确认| D5[加密配对并读取真实能力]
    D5 --> D6{所需能力是否存在}
    D6 -->|否| D7[只开放实际能力，不伪造]
    D6 -->|是| D8[设备 Ready 与授权范围]
    D8 --> D9[设备事件进入 Main]
    D8 --> D10[Main 发起设备工具调用]
    D10 --> D11{设备回执}
    D11 -->|applied| D12[更新真实状态 revision]
    D11 -->|failed| D13[显示失败与可恢复动作]
    D11 -->|超时或断线| D14[先读取状态对账]
    D14 --> D15{结果仍未知}
    D15 -->|是| D16[outcome_unknown，不盲目重试]
  end

  subgraph F5["F5 外部动作：prepare → commit → reconcile"]
    F5A[Agent 准备动作] --> E2[显示目标、正文、范围、成本与后果]
    E2 --> E3{用户决定}
    E3 -->|拒绝| E4[不执行，保留决定记录]
    E3 -->|允许一次| E5[冻结参数与幂等键]
    E5 --> E6[提交 Provider]
    E6 --> E7{真实结果}
    E7 -->|成功| E8[保存回执并交付]
    E7 -->|明确失败| E9[显示失败，不换键重发]
    E7 -->|未知| E10[按原对象对账]
    E10 --> E11{仍未知}
    E11 -->|是| E12[outcome_unknown，人工决定]
  end

  subgraph F6["F6 后台、锁屏与恢复"]
    G1[任务执行中切后台或锁屏] --> G2[先写检查点并关闭当前 epoch]
    G2 --> G3{系统允许继续吗}
    G3 -->|允许有限任务| G4[继续并显示真实进度]
    G3 -->|挂起或终止| G5[进入 parked，不假装运行]
    G4 --> G6[回到前台或进程重启]
    G5 --> G6
    G6 --> G7[恢复原 session、游标和任务状态]
    G7 --> G8{外部结果是否已发生}
    G8 -->|已确认| G9[继续后续步骤]
    G8 -->|未发生| G10[按原状态恢复]
    G8 -->|未知| G11[先对账，不重复副作用]
  end

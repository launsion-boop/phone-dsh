<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Same requirement as the library manifest: the instrumented test APK is its
         own App and binds the loopback origin itself. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- targetSdk >= 28 denies cleartext by default; the loopback origin is http
         on 127.0.0.1 (see pdsh_test_network_security_config.xml). -->
    <application android:networkSecurityConfig="@xml/pdsh_test_network_security_config" />
</manifest>

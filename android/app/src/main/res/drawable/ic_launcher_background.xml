<!--
  Adaptive-icon background layer: a full-bleed square, nothing else.

  It is a 108x108 vector rather than a <color> resource so that the layer is
  opaque over the whole canvas (the platform masks it to the launcher's own
  shape, and a colour resource would work too — this just keeps the layer pair
  in the same format). The colour is the icon palette's `pdsh_icon_background`,
  which is tokens.json colors.primary.light.

  No gradient, no shadow, no second shape: the foreground carries the mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@color/pdsh_icon_background"
        android:pathData="M0,0h108v108h-108z" />
</vector>

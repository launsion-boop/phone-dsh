<!--
  targetSdk >= 28 denies cleartext traffic by default. The engine's origin is
  http://127.0.0.1:<port> (the loopback server, never a public host), so exactly
  that origin is re-enabled here. Everything else keeps the platform default.
  Mirrors :engine's androidTest config, which the engine's own APK needs for the
  same reason. Without this file the page load fails with
  ERR_CLEARTEXT_NOT_PERMITTED before the worker can open the channel.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>

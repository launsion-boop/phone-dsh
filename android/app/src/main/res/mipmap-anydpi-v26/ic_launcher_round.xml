<!--
  The round-masked variant (`android:roundIcon`). It reuses the same two layers
  on purpose: the mark sits inside the safe zone, so a launcher that asks for a
  round icon gets the identical drawing under its own mask instead of a cropped
  or inset second design.

  A launcher that ignores `roundIcon` falls back to `ic_launcher`, whose layers
  are the same files.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>

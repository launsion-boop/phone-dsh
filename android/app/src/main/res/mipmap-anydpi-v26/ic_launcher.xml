<!--
  The launcher icon (`android:icon`). `-anydpi-v26` is the only density bucket
  this app ships because `minSdk = 26`: every supported device understands an
  adaptive icon, so a bitmap fallback would be dead weight and a second place
  for the mark to drift.

  Layers: `ic_launcher_background` (full-bleed square) under
  `ic_launcher_foreground` (the prompt mark). Colour and geometry live in those
  two files.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>

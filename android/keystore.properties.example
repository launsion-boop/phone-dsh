# SPDX-License-Identifier: MIT
#
# Release signing for :app — road (b), "真发布".
#
# Copy this file to `android/keystore.properties` (gitignored, as is the *.jks)
# and fill in real values. With no such file — or with a file that is
# incomplete, or whose storeFile does not exist — the release build falls back
# to road (a): AGP's debug signing config, so `assembleRelease` still produces
# an APK that `adb install` accepts. The fallback is announced in the Gradle
# log, carried in the APK (`BuildConfig.SIGNING_MODE` / `SIGNING_NOTICE` and the
# manifest `com.phonedsh.app.SIGNING_*` meta-data) and means the APK must not be
# published.
#
# ---------------------------------------------------------------------------
# 1. Generate the keystore (once, offline; keep the .jks and the passwords in a
#    password manager, and a second copy off this machine — losing them means
#    this applicationId can never be updated again):
#
#   keytool -genkey -v -keystore pdsh-release.jks -keyalg RSA -keysize 4096 \
#     -validity 10000 -alias pdsh
#
#    keyalg RSA / keysize 4096: play/app-signing-android requires
#    at least 2048-bit RSA today; 4096 removes a later rotation.
#    validity 10000 days (~27 years): the store rejects an upload key that
#    expires before the app does.
#
# 2. Put the .jks where this file says (or anywhere, absolute or relative) and
#    fill in the four values below.
#
# 3. Verify what you built:
#     cd android && ./gradlew :app:assembleRelease
#     aapt2 dump badging app/build/outputs/apk/release/app-release.apk | head -1
#     apksigner verify --print-certs app/build/outputs/apk/release/app-release.apk
#   and confirm the Gradle log says `[signing] release: road (b)`.
#
# ---------------------------------------------------------------------------
# The same four values can come from the environment instead of this file,
# which is what a CI runner should use so the password never lands on disk:
#
#   PDSH_KEYSTORE_FILE      -> storeFile
#   PDSH_KEYSTORE_PASSWORD  -> storePassword
#   PDSH_KEY_ALIAS          -> keyAlias
#   PDSH_KEY_PASSWORD       -> keyPassword
#
# The file wins when both are present. Values here are read at configuration
# time only; nothing is written back, and nothing in this repository may carry
# a real one.
# ---------------------------------------------------------------------------

# Path to the keystore. Relative paths resolve against `android/`, so
# `pdsh-release.jks` means `android/pdsh-release.jks`.
storeFile=pdsh-release.jks

# Passwords. Replace both placeholders; a leftover "CHANGE_ME" is not a
# credential and the build will fail to sign rather than fall back silently.
storePassword=CHANGE_ME

# The key inside the store. Must match the -alias passed to keytool.
keyAlias=pdsh

keyPassword=CHANGE_ME

<!--
  ACCESS_NETWORK_STATE is the only permission the SPI adapters need:
  ConnectivityManager.registerNetworkCallback / getActiveNetwork are gated on it
  and AndroidLifecycleSignals reads them for NetworkPath. Battery, thermal and
  activity-lifecycle readings need no permission. No component is declared: the
  adapters are constructed by the composition root, not started by the system.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>

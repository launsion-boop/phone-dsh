{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2024",
      "ESNext.Disposable",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "jsx": "react-jsx"
  },
  "include": [
    "exec-bridge/src",
    "subprocess-xl/src",
    "llm-bridge/src",
    "tool-journal/src",
    "lifecycle-gate/src",
    "channel/src",
    "worker-entry/src",
    "workflow-worker/src",
    "shell-ext/src",
    "bundle/entry.ts",
    "tests",
    "wasi-toolbox/src",
    "wasi-toolbox/python",
    "wasi-toolbox/git",
    "contract-tests",
    "phone-model-config/src/index.ts",
    "phone-feature-admin/src",
    "phone-mcp/src",
    "phone-shell/src/index.ts",
    "phone-native-preview/src/index.ts",
    "phone-directory-import/src/index.ts",
    "types"
  ]
}

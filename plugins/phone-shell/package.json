{
  "name": "@phone-dsh/dsh-phone-shell",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Phone command console: Worker bash over the VFS and the host's advertised read-only xz-shell accelerators, with no PTY.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
    "./contract": "./src/contract.ts",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@phone-dsh/dsh-exec-bridge": "0.1.0",
    "@phone-dsh/dsh-shell-ext": "0.1.0",
    "@phone-dsh/dsh-subprocess-xl": "0.1.0",
    "react": "^18.2.0"
  }
}

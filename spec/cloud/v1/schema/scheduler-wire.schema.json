{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BotCloudSchedulerWire v1",
  "description": "One phoneDSH mobile-scheduler wire message. Closed members; no user content/credentials. See spec/cloud/v1/README.md.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema",
        "op",
        "device_id",
        "bot_id",
        "routine_id",
        "revision"
      ],
      "properties": {
        "schema": {
          "const": "bot-cloud-schedule-request/v1"
        },
        "op": {
          "enum": [
            "register",
            "update",
            "delete"
          ]
        },
        "device_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "bot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "routine_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "type": "object",
          "required": [
            "kind",
            "timezone"
          ],
          "properties": {
            "kind": {
              "enum": [
                "interval",
                "daily",
                "weekly",
                "cron"
              ]
            },
            "timezone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "interval_minutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10080
            },
            "local_time": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "weekdays": {
              "type": "array",
              "minItems": 1,
              "maxItems": 7,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              }
            },
            "cron": {
              "type": "string",
              "minLength": 9,
              "maxLength": 64
            },
            "phase_minutes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 59
            }
          },
          "additionalProperties": false
        },
        "catch_up": {
          "enum": [
            "latest",
            "none"
          ]
        },
        "authorization_ref": {
          "type": "string",
          "pattern": "^record://(session/(?!\\.{1,2}#)[A-Za-z0-9._-]{1,64}#(0|[1-9][0-9]*)|event/[1-9][0-9]*)$",
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "schedule_id",
        "revision",
        "next_due_at_ms"
      ],
      "properties": {
        "schema": {
          "const": "bot-cloud-schedule-response/v1"
        },
        "schedule_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "next_due_at_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "device_id"
      ],
      "properties": {
        "schema": {
          "const": "bot-cloud-poll-request/v1"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "bot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "lease_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        },
        "wait_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "events",
        "server_time_ms"
      ],
      "properties": {
        "schema": {
          "const": "bot-cloud-poll-response/v1"
        },
        "events": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "event_id",
              "device_id",
              "bot_id",
              "routine_id",
              "occurrence_key",
              "occurrence_at_ms",
              "scheduled_for_ms",
              "lease",
              "schedule_revision"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{1,128}$"
              },
              "device_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{1,128}$"
              },
              "bot_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{1,128}$"
              },
              "routine_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{1,128}$"
              },
              "occurrence_key": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "occurrence_at_ms": {
                "type": "integer",
                "minimum": 0
              },
              "scheduled_for_ms": {
                "type": "integer",
                "minimum": 0
              },
              "lease": {
                "type": "object",
                "required": [
                  "lease_id",
                  "attempt",
                  "expires_at_ms"
                ],
                "properties": {
                  "lease_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._:-]{1,128}$"
                  },
                  "attempt": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "expires_at_ms": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              },
              "schedule_revision": {
                "type": "integer",
                "minimum": 0
              },
              "state": {
                "enum": [
                  "pending",
                  "leased",
                  "terminal"
                ]
              },
              "receipt": {
                "type": "object",
                "required": [
                  "receipt_id",
                  "outcome"
                ],
                "properties": {
                  "receipt_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._:-]{1,128}$"
                  },
                  "outcome": {
                    "enum": [
                      "delivered",
                      "skipped",
                      "failed",
                      "cancelled",
                      "unknown"
                    ]
                  },
                  "reason": {
                    "enum": [
                      "overlap",
                      "quiet",
                      "disabled",
                      "revoked",
                      "needs_reconciliation",
                      "crash",
                      "timeout",
                      "unavailable",
                      "local_attempt",
                      "superseded",
                      "user_stopped"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "server_time_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "device_id",
        "event_id",
        "receipt"
      ],
      "properties": {
        "schema": {
          "const": "bot-cloud-ack/v1"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "receipt": {
          "type": "object",
          "required": [
            "receipt_id",
            "occurrence_key",
            "outcome",
            "completed_at_ms"
          ],
          "properties": {
            "receipt_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "occurrence_key": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "outcome": {
              "enum": [
                "delivered",
                "skipped",
                "failed",
                "cancelled",
                "unknown"
              ]
            },
            "reason": {
              "enum": [
                "overlap",
                "quiet",
                "disabled",
                "revoked",
                "needs_reconciliation",
                "crash",
                "timeout",
                "unavailable",
                "local_attempt",
                "superseded",
                "user_stopped"
              ]
            },
            "completed_at_ms": {
              "type": "integer",
              "minimum": 0
            },
            "local_run_id": {
              "type": "string",
              "pattern": "^cloud-[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "device_id",
        "since_ms"
      ],
      "properties": {
        "schema": {
          "const": "bot-cloud-reconcile-request/v1"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "since_ms": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "cursor_ms": {
          "type": "integer",
          "minimum": 0
        },
        "include_terminal": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },

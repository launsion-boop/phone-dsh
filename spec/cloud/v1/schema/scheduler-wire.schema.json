              },
              "device_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{1,128}$"
              },
              "bot_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{1,128}$"
              },
              "routine_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{1,128}$"
              },
              "occurrence_key": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "occurrence_at_ms": {
                "type": "integer",
                "minimum": 0
              },
              "scheduled_for_ms": {
                "type": "integer",
                "minimum": 0
              },
              "lease": {
                "type": "object",
                "required": [
                  "lease_id",
                  "attempt",
                  "expires_at_ms"
                ],
                "properties": {
                  "lease_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._:-]{1,128}$"
                  },
                  "attempt": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "expires_at_ms": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              },
              "schedule_revision": {
                "type": "integer",
                "minimum": 0
              },
              "state": {
                "enum": [
                  "pending",
                  "leased",
                  "terminal"
                ]
              },
              "receipt": {
                "type": "object",
                "required": [
                  "receipt_id",
                  "outcome"
                ],
                "properties": {
                  "receipt_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._:-]{1,128}$"
                  },
                  "outcome": {
                    "enum": [
                      "delivered",
                      "skipped",
                      "failed",
                      "cancelled",
                      "unknown"
                    ]
                  },
                  "reason": {
                    "enum": [
                      "overlap",
                      "quiet",
                      "disabled",
                      "revoked",
                      "needs_reconciliation",
                      "crash",
                      "timeout",
                      "unavailable",
                      "local_attempt",
                      "superseded",
                      "user_stopped"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "next_cursor_ms": {
          "type": "integer",
          "minimum": 0
        },
        "server_time_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "accepted",
        "duplicate",
        "state",
        "server_time_ms"
      ],
      "properties": {
        "schema": {
          "const": "bot-cloud-ack-response/v1"
        },
        "accepted": {
          "type": "boolean"
        },
        "duplicate": {
          "type": "boolean"
        },
        "state": {
          "enum": [

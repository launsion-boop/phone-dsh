        "server_time_ms"
      ],
      "properties": {
        "schema": {
          "const": "bot-cloud-reconcile-response/v1"
        },
        "events": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "event_id",

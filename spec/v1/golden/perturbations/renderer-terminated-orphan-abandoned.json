{
  "id": "renderer-terminated-orphan-abandoned",
  "verb": "renderer_terminate",
  "title": "Renderer terminated with a dispatched step: the replacement cannot prove it, so the step is abandoned exactly once",
  "preconditions": {
    "host_state": "Running",
    "admission": "open",
    "epoch_open": true,
    "acked_mseq": 1,
    "open_steps": 1,
    "journaled_steps": 0,
    "exec_in_flight": false,
    "persisted_state": "Running",
    "worker_channel": "open",
    "notes": "One workspace write is acked and one tool step is dispatched. The scripted replacement Worker stays silent, so no resolved record can be obtained for the step."
  },
  "timeline": [
    {
      "at": 0,
      "event": "write acked; journal dispatched acked",
      "expect_state": "Running",
      "source": "Tests/PhoneDSHScenarioOrphanStepTests/PhoneDSHScenarioOrphanStepTests.swift:158-190"
    },
    {
      "at": 10,
      "event": "renderer / WebContent terminated",
      "detail": "the engine termination event closes admission and starts recovery; this is the uncatchable process death of the page's execution context",
      "expect_state": "Recovering",
      "source": "Tests/PhoneDSHControllerTests/HostStateMachineTests.swift:270-278"
    },
    {
      "at": 20,
      "event": "replacement Worker sends HELLO with a new boot id",
      "expect_state": "Recovering",
      "source": "Tests/PhoneDSHKillTests/Phase0KillMatrixTests.swift:159-161"
    },
    {
      "at": 30,
      "event": "bounded write-open reconcile",
      "detail": "the host opens the affected session for writing; the Worker produces no resolvable record for the step",
      "source": "Tests/PhoneDSHKillTests/PhoneDSHScenarioOrphanStepTests.swift:209-215"
    },
    {
      "at": 40,
      "event": "terminal abandonment recorded",
      "detail": "state abandoned, settled reason worker-terminated, history ends with abandoned",
      "source": "Tests/PhoneDSHKillTests/PhoneDSHScenarioOrphanStepTests.swift:200-208"
    },
    {
      "at": 50,
      "event": "one settlement event published",
      "detail": "exactly one bounded settlement event carries the reason and the step list for one recovery",
      "source": "Tests/PhoneDSHKillTests/PhoneDSHScenarioOrphanStepTests.swift:217-224"
    },
    {
      "at": 60,
      "event": "lease verified",
      "expect_state": "Running",
      "source": "Tests/PhoneDSHKillTests/PhoneDSHScenarioOrphanStepTests.swift:193-198"
    }
  ],
  "expected": {
    "state": "Running",
    "state_path": [
      "Running",
      "Recovering",
      "Running"

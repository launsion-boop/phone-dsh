      "steps_open": "swift-test",
      "steps_abandoned": "swift-test",
      "settlement_reason": "swift-test",
      "worker_rehello": "swift-test"
    }
  },
  "evidence_level": "swift-test",
  "source": "Tests/PhoneDSHKillTests/PhoneDSHScenarioOrphanStepTests.swift:168-225",
  "related_sources": [
    "Tests/PhoneDSHKillTests/Phase0KillMatrixTests.swift:171-211",

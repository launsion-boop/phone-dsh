{
  "id": "write-without-ack",
  "verb": "write_without_ack",
  "title": "A record appended to the WAL but never acknowledged survives and replays; the ack watermark is the only safe assertion bound",
  "preconditions": {
    "host_state": "Running",
    "admission": "open",
    "epoch_open": true,
    "acked_mseq": 2,
    "open_steps": 0,
    "journaled_steps": 1,
    "exec_in_flight": false,
    "persisted_state": "Running",
    "worker_channel": "open",
    "notes": "Two writes are level-1 acked. A third mutation is appended and the process disappears before VFS_ACK is written: no close, no fsync, no atexit handler."
  },
  "timeline": [
    {
      "at": 0,
      "event": "two writes acked",
      "expect_state": "Running",
      "source": "Tests/PhoneDSHLogTests/ForkRecoveryTests.swift:34-40"
    },
    {
      "at": 5,
      "event": "third mutation appended, no ack",
      "detail": "write() returned and the bytes are in the kernel page cache; the ack frame was never produced",
      "source": "Tests/PhoneDSHLogTests/ForkRecoveryTests.swift:50-59"
    },
    {
      "at": 15,
      "event": "process start",
      "expect_state": "Recovering",
      "source": "Tests/PhoneDSHControllerTests/HostStateMachineTests.swift:66-88"
    },
    {
      "at": 25,
      "event": "recovery replays the unacknowledged record",
      "detail": "the record is present and materialized: the append is the commit point, the ack is only the client's notification",
      "source": "Tests/PhoneDSHLogTests/ForkRecoveryTests.swift:61-79"
    },
    {
      "at": 35,
      "event": "lease verified",
      "expect_state": "Running",
      "source": "Tests/PhoneDSHKillTests/Phase0KillMatrixTests.swift:158"
    },
    {
      "at": 45,
      "event": "ack watermark check",
      "detail": "the acked watermark never regresses below its pre-exit value; the runner asserts the acked prefix, not the unacked tail",
      "source": "Tests/PhoneDSHKillTests/Phase0KillMatrixTests.swift:254-258"
    }
  ],
  "expected": {
    "state": "Running",
    "state_path": [
      "Running",
      "Recovering",
      "Running"
    ],
    "durability_level": "level_1",
    "wal_tail": "intact_open_epoch",
    "journal_gap": "none",
    "surfaced_to_user": "unmeasured",
    "admission": "open",
    "acked_prefix_preserved": true,
    "unacked_records_retained": true,
    "materialized_equals_replay": true,
    "steps_open": 0,
    "steps_abandoned": 0,
    "field_evidence": {
      "state": "swift-test",
      "state_path": "swift-test",
      "durability_level": "swift-test",
      "wal_tail": "swift-test",
      "journal_gap": "swift-source",
      "admission": "swift-test",
      "acked_prefix_preserved": "swift-test",
      "unacked_records_retained": "swift-test",
      "materialized_equals_replay": "swift-test",
      "steps_open": "swift-test",
      "steps_abandoned": "swift-test"
    }
  },
  "evidence_level": "swift-source",
  "source": "Tests/PhoneDSHLogTests/ForkRecoveryTests.swift:31-80",
  "related_sources": [
    "Tests/PhoneDSHKillTests/Phase0KillMatrixTests.swift:254-258",
    "Sources/PhoneDSHHarness/KillSupport.swift:301-314",
    "spec/v1/wal.md:96-104"
  ],
  "notes": "Both halves matter: a runner may not FAIL because an unacked record is present (it is legally retained), and a runner may not REQUIRE it to survive a power loss — level 1 promises process-death survival only. This fixture separates those two claims, which the kill matrix only states as 'every acked mseq is present'."
}

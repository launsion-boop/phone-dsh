{
  "contract": "pdsh.tono-account/1",
  "note": "Synthetic values only. No real phone number, token or SMS code appears here; tests judge these cases with a local fake and never contact account.tonoai.cn.",
  "constants": {
    "account_origin": "https://account.tonoai.cn",
    "cloud_origin": "https://pdsh.tonoai.cn",
    "client_id": "phone-dsh-ios",
    "otp_grant_type": "urn:tono:params:oauth:grant-type:phone-otp",
    "default_access_lifetime_seconds": 7200,
    "refresh_skew_seconds": 300,
    "reverify_after_seconds": 15552000,
    "inspect_body_limit_bytes": 16384,
    "credential_retry_max": 1,
    "identity_retry_max": 2,
    "identity_retry_default_seconds": 1,
    "identity_retry_cap_seconds": 30,
    "token_max_length": 4096,
    "record_version": 1
  },
  "phones": [
    {"input": "10000000000", "canonical": "+8610000000000"},
    {"input": " 100 0000 0000 ", "canonical": "+8610000000000"},
    {"input": "100-0000-0000", "canonical": "+8610000000000"},
    {"input": "+8610000000000", "canonical": "+8610000000000"},
    {"input": "+86 100 0000 0000", "canonical": "+8610000000000"},
    {"input": "", "canonical": null},
    {"input": "1000000000", "canonical": null},
    {"input": "100000000000", "canonical": null},
    {"input": "20000000000", "canonical": null},
    {"input": "8610000000000", "canonical": null},
    {"input": "008610000000000", "canonical": null},
    {"input": "+1 2025550100", "canonical": null},
    {"input": "+86100000000x0", "canonical": null},
    {"input": "１００００００００００", "canonical": null},
    {"input": "10000000000\n", "canonical": "+8610000000000"},
    {"input": "100.0000.0000", "canonical": null}
  ],
  "codes": [
    {"input": "123456", "canonical": "123456"},
    {"input": " 123456 ", "canonical": "123456"},
    {"input": "1234", "canonical": "1234"},
    {"input": "12345678", "canonical": "12345678"},
    {"input": "123", "canonical": null},
    {"input": "123456789", "canonical": null},
    {"input": "12a456", "canonical": null},
    {"input": "12 3456", "canonical": null},
    {"input": "１２３４５６", "canonical": null},
    {"input": "", "canonical": null}
  ],
  "requests": [
    {
      "name": "otp-send",
      "operation": "send_code",
      "input": {"phone": "+8610000000000"},
      "expect": {
        "method": "POST",
        "url": "https://account.tonoai.cn/v1/auth/otp/send",
        "headers": {"content-type": "application/json", "accept": "application/json"},
        "absent_headers": ["authorization", "x-api-key"],
        "body_json": {"phone": "+8610000000000", "purpose": "login", "client_id": "phone-dsh-ios"}
      }
    },
    {
      "name": "otp-login",
      "operation": "sign_in",
      "input": {
        "phone": "+8610000000000",
        "challenge_id": "ch_TEST_0001",
        "code": "123456",
        "device_info": {"platform": "ios", "device_name": "iPhone", "app_version": "0.1.0", "os_version": "26.1"}
      },
      "expect": {
        "method": "POST",
        "url": "https://account.tonoai.cn/v1/oauth/token",
        "headers": {"content-type": "application/json", "accept": "application/json"},
        "absent_headers": ["authorization", "x-api-key"],
        "body_json": {
          "grant_type": "urn:tono:params:oauth:grant-type:phone-otp",
          "client_id": "phone-dsh-ios",
          "phone": "+8610000000000",
          "challenge_id": "ch_TEST_0001",
          "code": "123456",
          "device_info": {"platform": "ios", "device_name": "iPhone", "app_version": "0.1.0", "os_version": "26.1"}
        }
      }
    },
    {
      "name": "refresh-form",
      "operation": "refresh",
      "input": {"refresh_token": "rt_TEST+/=~-._0001"},
      "expect": {
        "method": "POST",
        "url": "https://account.tonoai.cn/v1/oauth/token",
        "headers": {"content-type": "application/x-www-form-urlencoded", "accept": "application/json"},
        "absent_headers": ["authorization", "x-api-key"],
        "body": "grant_type=refresh_token&client_id=phone-dsh-ios&refresh_token=rt_TEST%2B%2F%3D~-._0001"
      }
    },
    {
      "name": "logout",
      "operation": "sign_out",
      "input": {"access_token": "at_TEST_ACCESS_0001"},
      "expect": {
        "method": "POST",
        "url": "https://account.tonoai.cn/v1/auth/logout",
        "headers": {"authorization": "Bearer at_TEST_ACCESS_0001", "accept": "application/json"},
        "absent_headers": ["x-api-key"],
        "body": ""
      }
    }
  ],
  "token_responses": [
    {"name": "full", "status": 200,
     "body": {"access_token": "at_TEST_ACCESS_0001", "refresh_token": "rt_TEST_REFRESH_0001", "token_type": "Bearer", "expires_in": 7200, "user": {"id": "u_TEST_0001", "phone": "+8610000001234"}, "scope": "openid"},
     "expect": {"valid": true, "access_token": "at_TEST_ACCESS_0001", "refresh_token": "rt_TEST_REFRESH_0001", "expires_in": 7200, "user_id": "u_TEST_0001", "phone_hint": "1234"}},
    {"name": "minimal", "status": 200,
     "body": {"access_token": "at_TEST_ACCESS_0002", "refresh_token": "rt_TEST_REFRESH_0002"},
     "expect": {"valid": true, "access_token": "at_TEST_ACCESS_0002", "refresh_token": "rt_TEST_REFRESH_0002", "expires_in": 7200, "user_id": null, "phone_hint": null}},
    {"name": "lowercase-bearer-short-life", "status": 200,
     "body": {"access_token": "at_TEST_ACCESS_0003", "refresh_token": "rt_TEST_REFRESH_0003", "token_type": "bearer", "expires_in": 60, "user": {"id": 42}},
     "expect": {"valid": true, "access_token": "at_TEST_ACCESS_0003", "refresh_token": "rt_TEST_REFRESH_0003", "expires_in": 60, "user_id": null, "phone_hint": null}},
    {"name": "short-phone-no-hint", "status": 200,
     "body": {"access_token": "at_TEST_ACCESS_0004", "refresh_token": "rt_TEST_REFRESH_0004", "user": {"id": "u_TEST_0004", "phone": "12"}},
     "expect": {"valid": true, "access_token": "at_TEST_ACCESS_0004", "refresh_token": "rt_TEST_REFRESH_0004", "expires_in": 7200, "user_id": "u_TEST_0004", "phone_hint": null}},
    {"name": "missing-refresh", "status": 200, "body": {"access_token": "at_TEST_ACCESS_0005"}, "expect": {"valid": false}},
    {"name": "missing-access", "status": 200, "body": {"refresh_token": "rt_TEST_REFRESH_0006"}, "expect": {"valid": false}},
    {"name": "empty-access", "status": 200, "body": {"access_token": "", "refresh_token": "rt_TEST_REFRESH_0007"}, "expect": {"valid": false}},
    {"name": "api-key-shaped-access", "status": 200, "body": {"access_token": "pdsk_TEST_NOT_A_USER_TOKEN", "refresh_token": "rt_TEST_REFRESH_0008"}, "expect": {"valid": false}},
    {"name": "whitespace-in-token", "status": 200, "body": {"access_token": "at_TEST ACCESS", "refresh_token": "rt_TEST_REFRESH_0009"}, "expect": {"valid": false}},
    {"name": "control-in-refresh", "status": 200, "body": {"access_token": "at_TEST_ACCESS_0010", "refresh_token": "rt_TEST\u0001"}, "expect": {"valid": false}},
    {"name": "non-string-token", "status": 200, "body": {"access_token": 12345, "refresh_token": "rt_TEST_REFRESH_0011"}, "expect": {"valid": false}},
    {"name": "token-type-mac", "status": 200, "body": {"access_token": "at_TEST_ACCESS_0012", "refresh_token": "rt_TEST_REFRESH_0012", "token_type": "mac"}, "expect": {"valid": false}},
    {"name": "expires-zero", "status": 200, "body": {"access_token": "at_TEST_ACCESS_0013", "refresh_token": "rt_TEST_REFRESH_0013", "expires_in": 0}, "expect": {"valid": false}},
    {"name": "expires-string", "status": 200, "body": {"access_token": "at_TEST_ACCESS_0014", "refresh_token": "rt_TEST_REFRESH_0014", "expires_in": "7200"}, "expect": {"valid": false}},
    {"name": "expires-fraction", "status": 200, "body": {"access_token": "at_TEST_ACCESS_0015", "refresh_token": "rt_TEST_REFRESH_0015", "expires_in": 7200.5}, "expect": {"valid": false}},
    {"name": "not-object", "status": 200, "body_text": "[]", "expect": {"valid": false}},
    {"name": "not-json", "status": 200, "body_text": "ok", "expect": {"valid": false}}
  ],
  "otp_outcomes": [
    {"name": "challenge", "status": 200, "body": {"challenge_id": "ch_TEST_0001", "expires_in": 300}, "expect": {"outcome": "challenge", "challenge_id": "ch_TEST_0001"}},
    {"name": "created", "status": 201, "body": {"challenge_id": "ch_TEST_0002"}, "expect": {"outcome": "challenge", "challenge_id": "ch_TEST_0002"}},
    {"name": "no-challenge", "status": 200, "body": {}, "expect": {"outcome": "protocol_error"}},
    {"name": "empty-challenge", "status": 200, "body": {"challenge_id": ""}, "expect": {"outcome": "protocol_error"}},
    {"name": "bad-phone", "status": 400, "body": {"error": {"code": "invalid_phone", "message": "x"}}, "expect": {"outcome": "rejected"}},
    {"name": "throttled", "status": 429, "headers": {"retry-after": "60"}, "body": {"error": {"code": "rate_limited"}}, "expect": {"outcome": "rate_limited", "retry_after_seconds": 60}},
    {"name": "throttled-no-header", "status": 429, "body": {}, "expect": {"outcome": "rate_limited", "retry_after_seconds": null}},
    {"name": "server", "status": 502, "body_text": "bad gateway", "expect": {"outcome": "transient"}},
    {"name": "transport", "transport_error": true, "expect": {"outcome": "transient"}}
  ],
  "login_outcomes": [
    {"name": "ok", "status": 200, "body": {"access_token": "at_TEST_ACCESS_0001", "refresh_token": "rt_TEST_REFRESH_0001", "expires_in": 7200}, "expect": {"outcome": "signed_in"}},
    {"name": "ok-but-invalid", "status": 200, "body": {"access_token": "at_TEST_ACCESS_0001"}, "expect": {"outcome": "protocol_error"}},
    {"name": "wrong-code", "status": 400, "body": {"error": "invalid_grant", "error_description": "x"}, "expect": {"outcome": "invalid_code"}},
    {"name": "wrong-code-401", "status": 401, "body": {"error": {"code": "invalid_code"}}, "expect": {"outcome": "invalid_code"}},
    {"name": "forbidden", "status": 403, "body": {"error": {"code": "account_disabled"}}, "expect": {"outcome": "rejected"}},
    {"name": "throttled", "status": 429, "headers": {"retry-after": "30"}, "body": {}, "expect": {"outcome": "rate_limited", "retry_after_seconds": 30}},
    {"name": "unavailable", "status": 503, "headers": {"retry-after": "5"}, "body": {"error": {"code": "identity_unavailable"}}, "expect": {"outcome": "transient"}},
    {"name": "transport", "transport_error": true, "expect": {"outcome": "transient"}}
  ],
  "refresh_outcomes": [
    {"name": "rotated", "status": 200, "body": {"access_token": "at_TEST_ACCESS_0002", "refresh_token": "rt_TEST_REFRESH_0002", "expires_in": 7200}, "expect": {"outcome": "rotated"}},
    {"name": "rotated-invalid-body", "status": 200, "body": {"access_token": "at_TEST_ACCESS_0002"}, "expect": {"outcome": "session_ended"}},
    {"name": "rotated-not-json", "status": 200, "body_text": "<html>", "expect": {"outcome": "session_ended"}},
    {"name": "reused-or-expired", "status": 400, "body": {"error": "invalid_grant"}, "expect": {"outcome": "session_ended"}},
    {"name": "unauthorized", "status": 401, "body": {"error": {"code": "session_revoked"}}, "expect": {"outcome": "session_ended"}},
    {"name": "forbidden", "status": 403, "body": {}, "expect": {"outcome": "session_ended"}},
    {"name": "throttled", "status": 429, "headers": {"retry-after": "5"}, "body": {}, "expect": {"outcome": "transient"}},
    {"name": "server", "status": 500, "body_text": "", "expect": {"outcome": "transient"}},
    {"name": "identity-unavailable", "status": 503, "headers": {"retry-after": "3"}, "body": {"error": {"code": "identity_unavailable"}}, "expect": {"outcome": "transient"}},
    {"name": "not-found", "status": 404, "body": {}, "expect": {"outcome": "transient"}},
    {"name": "transport", "transport_error": true, "expect": {"outcome": "transient"}}
  ],
  "session_records": [
    {"name": "v1", "stored_text": "{\"version\":1,\"refresh_token\":\"rt_TEST_REFRESH_0001\",\"login_at_ms\":1762214400000,\"user_id\":\"u_TEST_0001\",\"phone_hint\":\"1234\"}",
     "expect": {"readable": true, "refresh_token": "rt_TEST_REFRESH_0001", "login_at_ms": 1762214400000, "user_id": "u_TEST_0001", "phone_hint": "1234"}},
    {"name": "v1-nulls", "stored_text": "{\"version\":1,\"refresh_token\":\"rt_TEST_REFRESH_0001\",\"login_at_ms\":1762214400000,\"user_id\":null,\"phone_hint\":null}",
     "expect": {"readable": true, "refresh_token": "rt_TEST_REFRESH_0001", "login_at_ms": 1762214400000, "user_id": null, "phone_hint": null}},
    {"name": "v1-unknown-member", "stored_text": "{\"version\":1,\"refresh_token\":\"rt_TEST_REFRESH_0001\",\"login_at_ms\":1762214400000,\"future\":true}",
     "expect": {"readable": true, "refresh_token": "rt_TEST_REFRESH_0001", "login_at_ms": 1762214400000, "user_id": null, "phone_hint": null}},
    {"name": "v2", "stored_text": "{\"version\":2,\"refresh_token\":\"rt_TEST_REFRESH_0001\",\"login_at_ms\":1762214400000}", "expect": {"readable": false}},
    {"name": "no-version", "stored_text": "{\"refresh_token\":\"rt_TEST_REFRESH_0001\",\"login_at_ms\":1762214400000}", "expect": {"readable": false}},
    {"name": "no-refresh", "stored_text": "{\"version\":1,\"login_at_ms\":1762214400000}", "expect": {"readable": false}},
    {"name": "empty-refresh", "stored_text": "{\"version\":1,\"refresh_token\":\"\",\"login_at_ms\":1762214400000}", "expect": {"readable": false}},
    {"name": "negative-login", "stored_text": "{\"version\":1,\"refresh_token\":\"rt_TEST_REFRESH_0001\",\"login_at_ms\":-1}", "expect": {"readable": false}},
    {"name": "string-login", "stored_text": "{\"version\":1,\"refresh_token\":\"rt_TEST_REFRESH_0001\",\"login_at_ms\":\"1762214400000\"}", "expect": {"readable": false}},
    {"name": "not-json", "stored_text": "rt_TEST_REFRESH_0001", "expect": {"readable": false}}
  ],
  "clock": [
    {"name": "fresh", "issued_at_ms": 0, "expires_in": 7200, "login_at_ms": 0, "now_ms": 0, "expect": "use"},
    {"name": "before-skew", "issued_at_ms": 0, "expires_in": 7200, "login_at_ms": 0, "now_ms": 6899999, "expect": "use"},
    {"name": "at-skew", "issued_at_ms": 0, "expires_in": 7200, "login_at_ms": 0, "now_ms": 6900000, "expect": "refresh"},
    {"name": "expired", "issued_at_ms": 0, "expires_in": 7200, "login_at_ms": 0, "now_ms": 7200001, "expect": "refresh"},
    {"name": "short-life", "issued_at_ms": 0, "expires_in": 60, "login_at_ms": 0, "now_ms": 29999, "expect": "use"},
    {"name": "short-life-half", "issued_at_ms": 0, "expires_in": 60, "login_at_ms": 0, "now_ms": 30000, "expect": "refresh"},
    {"name": "reverify-edge", "issued_at_ms": 15551990000, "expires_in": 7200, "login_at_ms": 0, "now_ms": 15551999999, "expect": "use"},
    {"name": "reverify", "issued_at_ms": 15551990000, "expires_in": 7200, "login_at_ms": 0, "now_ms": 15552000000, "expect": "reverify_required"},
    {"name": "clock-behind-login", "issued_at_ms": 1000, "expires_in": 7200, "login_at_ms": 1000, "now_ms": 0, "expect": "refresh"}
  ],
  "cloud_responses": [
    {"name": "expired-code", "url": "https://pdsh.tonoai.cn/v1/llm/anthropic/v1/messages", "status": 401,
     "body": {"error": {"type": "authentication_error", "code": "credential_expired", "message": "x", "request_id": "req_TEST"}}, "expect": {"action": "refresh_retry"}},
    {"name": "expired-anthropic-type", "url": "https://pdsh.tonoai.cn/v1/llm/anthropic/v1/messages", "status": 401,
     "body": {"type": "error", "error": {"type": "credential_expired", "message": "x"}}, "expect": {"action": "refresh_retry"}},
    {"name": "expired-search", "url": "https://pdsh.tonoai.cn/v1/web/search", "status": 401,
     "body": {"error": {"code": "credential_expired"}}, "expect": {"action": "refresh_retry"}},
    {"name": "expired-padded-at-limit", "url": "https://pdsh.tonoai.cn/v1/web/search", "status": 401,
     "body": {"error": {"code": "credential_expired"}}, "pad_to_bytes": 16384, "expect": {"action": "refresh_retry"}},
    {"name": "expired-over-limit", "url": "https://pdsh.tonoai.cn/v1/web/search", "status": 401,
     "body": {"error": {"code": "credential_expired"}}, "pad_to_bytes": 16385, "expect": {"action": "forward"}},
    {"name": "revoked", "url": "https://pdsh.tonoai.cn/v1/llm/anthropic/v1/messages", "status": 401,
     "body": {"error": {"type": "authentication_error", "code": "credential_revoked"}}, "expect": {"action": "forward"}},
    {"name": "invalid", "url": "https://pdsh.tonoai.cn/v1/llm/anthropic/v1/messages", "status": 401,
     "body": {"type": "error", "error": {"type": "authentication_error", "message": "invalid x-api-key"}}, "expect": {"action": "forward"}},
    {"name": "expired-in-message-only", "url": "https://pdsh.tonoai.cn/v1/web/search", "status": 401,
     "body": {"error": {"code": "invalid_credential", "message": "credential_expired"}}, "expect": {"action": "forward"}},
    {"name": "expired-not-json", "url": "https://pdsh.tonoai.cn/v1/web/search", "status": 401,
     "body_text": "credential_expired", "expect": {"action": "forward"}},
    {"name": "expired-other-origin", "url": "https://api.example.invalid/v1/messages", "status": 401,
     "body": {"error": {"code": "credential_expired"}}, "expect": {"action": "forward"}},
    {"name": "expired-other-port", "url": "https://pdsh.tonoai.cn:8443/v1/web/search", "status": 401,
     "body": {"error": {"code": "credential_expired"}}, "expect": {"action": "forward"}},
    {"name": "expired-http", "url": "http://pdsh.tonoai.cn/v1/web/search", "status": 401,
     "body": {"error": {"code": "credential_expired"}}, "expect": {"action": "forward"}},
    {"name": "expired-on-403", "url": "https://pdsh.tonoai.cn/v1/web/search", "status": 403,

  "retry_flows": [
    {"name": "expired-then-ok", "responses": [{"status": 401, "code": "credential_expired"}, {"status": 200}], "refresh": "new_value",
     "expect": {"contacts": 2, "final_status": 200, "invalidations": 1, "sleeps_seconds": []}},
    {"name": "expired-same-credential", "responses": [{"status": 401, "code": "credential_expired"}], "refresh": "same_value",
     "expect": {"contacts": 1, "final_status": 401, "invalidations": 1, "sleeps_seconds": []}},
    {"name": "expired-refresh-fails", "responses": [{"status": 401, "code": "credential_expired"}], "refresh": "unavailable",
     "expect": {"contacts": 1, "final_status": 401, "invalidations": 1, "sleeps_seconds": []}},
    {"name": "expired-twice", "responses": [{"status": 401, "code": "credential_expired"}, {"status": 401, "code": "credential_expired"}], "refresh": "new_value",
     "expect": {"contacts": 2, "final_status": 401, "invalidations": 1, "sleeps_seconds": []}},
    {"name": "revoked-no-retry", "responses": [{"status": 401, "code": "credential_revoked"}], "refresh": "new_value",
     "expect": {"contacts": 1, "final_status": 401, "invalidations": 0, "sleeps_seconds": []}},
    {"name": "identity-then-ok", "responses": [{"status": 503, "code": "identity_unavailable", "retry_after": "2"}, {"status": 200}], "refresh": "new_value",
     "expect": {"contacts": 2, "final_status": 200, "invalidations": 0, "sleeps_seconds": [2]}},

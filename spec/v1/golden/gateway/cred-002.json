{
  "id": "gw-cred-002",
  "rule": "credential-injection",
  "kind": "request",
  "source": "Sources/PhoneDSHGateway/ModelGateway.swift:1031",
  "references": [
    "Tests/PhoneDSHGatewayTests/ModelGatewayTests.swift:126",
    "Tests/PhoneDSHGatewayTests/ModelGatewayTests.swift:130"
  ],
  "note": "Caller credentials are a denylist drop plus a same-name override: the host value is authoritative and the drop is counted, not silent.",
  "input": {
    "method": "POST",
    "url": "https://api.example.invalid/v1/messages",
    "headers": {
      "authorization": "Bearer sk-SENTINEL-DO-NOT-USE",
      "x-pdsh-upstream-authorization": "Bearer sk-SENTINEL-DO-NOT-USE",
      "x-api-key": "sk-SENTINEL-DO-NOT-USE",
      "content-type": "application/json"
    },
    "allowlist": [
      "https://api.example.invalid"
    ],
    "credential": {
      "kind": "api-key",
      "header": "x-api-key",
      "value": "sk-HOST-API-KEY-PLACEHOLDER"
    }
  },
  "expect": {
    "dispatch": "allow",
    "outbound_headers": {
      "content-type": "application/json",
      "x-api-key": "sk-HOST-API-KEY-PLACEHOLDER"
    },
    "stripped": [
      "authorization",
      "x-pdsh-upstream-authorization"
    ],
    "outbound_url": "https://api.example.invalid/v1/messages"
  }
}

{
  "id": "gw-resp-006",
  "rule": "response-redaction",
  "kind": "response",
  "source": "Sources/PhoneDSHGateway/SensitiveResponseBody.swift:175",
  "references": [
    "spec/v1/gateway-security.md:136"
  ],
  "note": "HEAD and 1xx/204/205/304 responses carry no body even when the origin sends bytes: the body is suppressed (not withheld), and the empty response is still recorded. This vector exercises HEAD+204; the checker applies the rule to the whole class and the Kotlin tests cover 205/304.",
  "input": {
    "method": "HEAD",
    "url": "https://api.example.invalid/v1/models",
    "headers": {
      "accept": "application/json"
    },
    "allowlist": [
      "https://api.example.invalid"
    ],
    "credential": {
      "kind": "none"
    },
    "response": {
      "status": 204,
      "headers": {
        "content-type": "text/plain",
        "x-echo": "ordinary"
      },
      "body": "must-not-be-forwarded"
    }
  },
  "expect": {
    "dispatch": "allow",
    "outbound_headers": {
      "cache-control": "no-store",
      "content-type": "text/plain",
      "x-echo": "ordinary"
    },
    "stripped": [],
    "outbound_url": "https://api.example.invalid/v1/models",
    "body": "",
    "body_bytes": 0,
    "body_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
    "body_withheld": false,
    "log": {
      "recorded": true,
      "reason": "recorded_ok",
      "body_bytes": 0,
      "retained_bytes": 0
    }
  }
}

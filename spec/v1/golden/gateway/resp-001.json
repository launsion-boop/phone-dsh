    ],
    "credential": {
      "kind": "headers",
      "headers": {
        "authorization": "Bearer mcp-device-placeholder",
        "x-mcp-token": "mcp-header-placeholder"
      }
    },
    "response": {
      "status": 401,
      "headers": {
        "content-type": "text/plain",
        "x-echo": "Bearer mcp-device-placeholder"
      },
      "body": "rejected: Bearer mcp-device-placeholder"
    }
  },
  "expect": {
    "dispatch": "allow",
    "outbound_headers": {
      "cache-control": "no-store",
      "content-type": "application/json; charset=utf-8",
      "x-echo": "[redacted]"
    },
    "stripped": [],
    "outbound_url": "https://internal.example.invalid/mcp",
    "body": "{\"error\":{\"code\":-32000,\"message\":\"MCP upstream returned HTTP 401; response body withheld\"},\"id\":null,\"jsonrpc\":\"2.0\"}",
    "body_withheld": true,
    "log": {
      "recorded": false,

{
  "id": "gw-redir-001",
  "rule": "redirect-scope",
  "kind": "redirect-chain",
  "source": "Sources/PhoneDSHGateway/GatewaySession.swift:368",
  "references": [
    "Tests/PhoneDSHGatewayTests/ModelGatewayTests.swift:1269"
  ],
  "note": "A redirect hop outside the allow-list is never followed; the original 3xx is handed to the caller instead.",
  "input": {
    "method": "POST",
    "url": "https://api.example.invalid/v1/messages",
    "headers": {
      "content-type": "application/json"
    },
    "allowlist": [
      "https://api.example.invalid"
    ],
    "credential": {
      "kind": "api-key",
      "header": "x-api-key",
      "value": "sk-HOST-API-KEY-PLACEHOLDER"
    },
    "redirects": [
      {
        "status": 302,
        "location": "https://internal.example.invalid/v1/messages"
      }
    ]
  },
  "expect": {
    "dispatch": "deny",
    "outbound_headers": {
      "content-type": "application/json",
      "x-api-key": "sk-HOST-API-KEY-PLACEHOLDER"
    },
    "stripped": [],
    "outbound_url": "https://api.example.invalid/v1/messages",
    "deny_reason": "redirect_target_not_allowed",
    "redirects_followed": 0,
    "final_url": "https://internal.example.invalid/v1/messages",
    "status": 302
  }
}

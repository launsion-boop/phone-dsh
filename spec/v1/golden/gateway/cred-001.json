{
  "id": "gw-cred-001",
  "rule": "credential-injection",
  "kind": "request",
  "source": "Sources/PhoneDSHGateway/ModelGateway.swift:1018",
  "references": [
    "Tests/PhoneDSHGatewayTests/ModelGatewayCredentialRoutingTests.swift:92",
    "Tests/PhoneDSHGatewayTests/ModelGatewayCredentialRoutingTests.swift:102"
  ],
  "note": "The provider resolves the credential for the URL scope; the gateway applies it after copying caller headers.",
  "input": {
    "method": "POST",
    "url": "https://api.example.invalid/v1/messages",
    "headers": {
      "content-type": "application/json"
    },
    "allowlist": [
      "https://api.example.invalid"
    ],
    "credential": {
      "kind": "api-key",
      "header": "x-api-key",
      "value": "sk-HOST-API-KEY-PLACEHOLDER"
    }
  },
  "expect": {
    "dispatch": "allow",
    "outbound_headers": {
      "content-type": "application/json",
      "x-api-key": "sk-HOST-API-KEY-PLACEHOLDER"
    },
    "stripped": [],
    "outbound_url": "https://api.example.invalid/v1/messages"
  }
}

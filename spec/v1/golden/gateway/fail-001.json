{
  "id": "gw-fail-001",
  "rule": "failure-surface",
  "kind": "request",
  "source": "Sources/PhoneDSHGateway/ModelGateway.swift:580",
  "references": [
    "Tests/PhoneDSHGatewayTests/ModelGatewayEgressClassificationTests.swift:140"
  ],
  "note": "A pre-flight denial fails loud with the structured host_not_allowed cause and never opens a connection; the caller's credential header is not echoed anywhere.",
  "input": {
    "method": "GET",
    "url": "https://other.example.invalid/v1/x",
    "headers": {
      "authorization": "Bearer sk-SENTINEL-DO-NOT-USE"
    },
    "allowlist": [
      "https://api.example.invalid"
    ],
    "credential": {
      "kind": "none"
    }
  },
  "expect": {
    "dispatch": "deny",
    "outbound_headers": {},
    "stripped": [],
    "outbound_url": "",
    "deny_reason": "host_not_allowed",
    "failure": {
      "code": "host_not_allowed",
      "proxy_status": 403,
      "proxy_error": "forbidden",
      "upstream_contacts": 0,
      "host": "other.example.invalid"
    }
  }
}

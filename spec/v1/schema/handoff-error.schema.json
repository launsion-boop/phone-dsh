{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "handoff error envelope",
  "description": "Error body of every /v1/handoff/* endpoint; HTTP status carries the class.",
  "type": "object",
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "unauthorized",
            "fence_conflict",
            "stale_generation",
            "snapshot_conflict",
            "segments_gap",
            "bad_request",
            "payload_mismatch",
            "internal"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "applied_mseq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "expected_mseq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

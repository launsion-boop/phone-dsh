{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LIFECYCLE payload",
  "description": "LIFECYCLE payload of the ordered channel.",
  "type": "object",
  "required": [
    "state",
    "budget",
    "admission",
    "reason"
  ],
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "run",
        "pause",
        "stop"
      ]
    },
    "budget": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "admission": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ]
    },
    "reason": {
      "type": "string"
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "handoff segments response",
  "description": "POST /v1/handoff/segments response body: the applied contiguous mseq and the admission decision.",
  "type": "object",
  "required": [
    "base_mseq",
    "applied_mseq",
    "wal_seq",
    "admission"
  ],
  "properties": {
    "base_mseq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "applied_mseq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "wal_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "admission": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ]
    }
  },
  "additionalProperties": false
}

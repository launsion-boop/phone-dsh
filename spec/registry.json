      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "P[0-9]{2}"
        },
        "owner_role": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true

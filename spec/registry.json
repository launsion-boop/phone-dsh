          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "glob"
            ],
            "additionalProperties": false,
            "properties": {
              "glob": {
                "type": "string",
                "minLength": 1
              },
              "exclude": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "contains_any": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          },
          "minItems": 1
        },
        "status": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "implemented",
              "partial",
              "target",
              "draft",
              "legacy",
              "deprecated"
            ]
          },
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source": {
          "type": "object",
          "required": [
            "authority",
            "ends",
            "evidence",
            "triggers"
          ],
          "additionalProperties": false,
          "properties": {
            "authority": {
              "type": "string",
              "minLength": 1
            },
            "ends": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            },
            "triggers": {

{
  "name": "engine-launch",
  "schema": "schema/engine-launch.schema.json",
  "notes": "spec/host/v1/README.md §10.2: decision order, threshold constants and ReadySweep step gate; PC-20261120-engine-first-launch. Swift and Kotlin tests read this file directly; do not copy a vector.",
  "instance": {
    "contract": "engine-launch",
    "revision": 3,
    "constants": {
      "minLeaseForColdBootMs": 20000,
      "minLeaseForResumeMs": 8000,
      "parkMarginMs": 5000,
      "cloudPullFreshnessMs": 30000,
      "stepBudgetMs": {
        "userOutbox": 2000,
        "externalAdmission": 2000,
        "cloudTaskPull": 5000,
        "botHeldInbox": 2000,
        "missedRoutines": 5000,
        "connectorScan": 10000,
        "approvalReminderSync": 1000,
        "dshSchedule": 3000,
        "hostRetries": 2000
      },
      "connectorScanIntervalMs": 1800000,
      "minBackgroundDelayMs": 60000
    },
    "wakeReasons": [
      "coldLaunch",
      "foreground",
      "unlock",
      "cloudTaskPush",
      "boardWake",
      "bleRequest",
      "lanRequest",
      "pcLinkRequest",
      "bgProcessing",
      "routineNotificationTap",
      "engineRecovered",
      "scheduledDemand",
      "bgAppRefresh"
    ],
    "decisions": [
      "boot",
      "resume",
      "ready",
      "nativeOnly",
      "defer",
      "needsAttention"
    ],
    "steps": [
      "userOutbox",
      "externalAdmission",
      "cloudTaskPull",
      "botHeldInbox",
      "missedRoutines",
      "connectorScan",
      "approvalReminderSync",
      "dshSchedule",
      "hostRetries"
    ],

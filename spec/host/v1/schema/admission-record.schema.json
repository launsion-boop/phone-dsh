        "admittedAtMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "expiresAtMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "stage": {"type": "string", "enum": ["completed", "failed", "expired", "cancelled", "unknown"]},
        "attempts": {"type": "integer", "minimum": 0, "maximum": 12},
        "linkedAtMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "settledAtMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},

{
  "title": "HostEngineLaunchVectors v1",
  "description": "The shared engine-launch vector document of spec/host/v1/README.md section 10.2. It freezes the closed WakeReason, decision and ReadySweep step vocabularies, the provisional threshold and per-step-budget constants, and the valid/invalid decision and sweep vectors. Swift (iOS, this round) and Kotlin (Android, later) both read golden/engine-launch.json and this schema directly; neither end retypes a vector or a threshold. Identifiers use the section 10.2 spellings case-sensitively. Invalid vectors intentionally live outside the decision input domain: their wrapper is schema-valid and the end's real decoder must reject the inner input.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "revision",
    "constants",
    "wakeReasons",
    "decisions",
    "steps",
    "decisionVectors",
    "invalidDecisionVectors",
    "sweepVectors",
    "invalidSweepVectors"
  ],
  "properties": {
    "contract": {
      "const": "engine-launch"
    },
    "revision": {
      "const": 1
    },
    "constants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minLeaseForColdBootMs",
        "minLeaseForResumeMs",
        "parkMarginMs",
        "cloudPullFreshnessMs",
        "stepBudgetMs"
      ],
      "properties": {
        "minLeaseForColdBootMs": {
          "const": 20000
        },
        "minLeaseForResumeMs": {
          "const": 8000
        },
        "parkMarginMs": {
          "const": 5000
        },
        "cloudPullFreshnessMs": {
          "const": 30000
        },
        "stepBudgetMs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "userOutbox",
            "externalAdmission",
            "cloudTaskPull",
            "botHeldInbox",
            "missedRoutines",
            "connectorScan",
            "approvalReminderSync"
          ],
          "properties": {
            "userOutbox": {
              "const": 2000
            },
            "externalAdmission": {
              "const": 2000
            },
            "cloudTaskPull": {
              "const": 5000
            },
            "botHeldInbox": {
              "const": 2000
            },
            "missedRoutines": {
              "const": 5000
            },
            "connectorScan": {
              "const": 10000
            },
            "approvalReminderSync": {
              "const": 1000
            }
          }
        }
      }
    },
    "wakeReasons": {
      "description": "The closed WakeReason set of section 10.2.1, in contract order.",
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "enum": [
          "coldLaunch",
          "foreground",
          "unlock",
          "cloudTaskPush",
          "boardWake",
          "bleRequest",
          "lanRequest",
          "pcLinkRequest",
          "bgProcessing",
          "routineNotificationTap",
          "engineRecovered"
        ]
      }
    },
    "decisions": {
      "description": "The closed decision set of section 10.2.4, in evaluation order.",
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "enum": [
          "boot",
          "resume",
          "ready",
          "nativeOnly",
          "defer",
          "needsAttention"
        ]
      }
    },
    "steps": {
      "description": "The closed ReadySweep step set of section 10.2.5, in execution order.",
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "enum": [
          "userOutbox",
          "externalAdmission",
          "cloudTaskPull",
          "botHeldInbox",
          "missedRoutines",
          "connectorScan",
          "approvalReminderSync"
        ]
      }
    },
    "decisionVectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "input",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "note": {
            "type": "string",
            "maxLength": 400
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "foreground",
              "residentAudio",
              "hostState",
              "leaseRemainingMs",
              "userStopped",
              "needsReset"
            ],
            "properties": {
              "reason": {
                "enum": [
                  "coldLaunch",
                  "foreground",
                  "unlock",
                  "cloudTaskPush",
                  "boardWake",
                  "bleRequest",
                  "lanRequest",
                  "pcLinkRequest",
                  "bgProcessing",
                  "routineNotificationTap",
                  "engineRecovered"
                ]
              },
              "foreground": {
                "type": "boolean"
              },
              "residentAudio": {
                "type": "boolean"
              },
              "hostState": {
                "enum": [
                  "absent",
                  "parked",
                  "running",
                  "failed"
                ]
              },
              "leaseRemainingMs": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "userStopped": {
                "type": "boolean"
              },
              "needsReset": {
                "type": "boolean"
              }
            }
          },
          "expected": {
            "enum": [
              "boot",
              "resume",
              "ready",
              "nativeOnly",
              "defer",
              "needsAttention"
            ]
          }
        }
      }
    },
    "invalidDecisionVectors": {
      "description": "Wrapper-valid cases whose inner input the real decoder MUST reject. The inner object is intentionally unrestricted; the rejection reason is data for the test report.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "input",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "note": {
            "type": "string",
            "maxLength": 400
          },
          "input": {
            "type": "object"
          },
          "reason": {
            "enum": [
              "missing-member",
              "member-type",
              "unknown-reason",
              "unknown-host-state",
              "lease-negative",
              "lease-not-integer"
            ]
          }
        }
      }
    },
    "sweepVectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "step",
          "remainingMs",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "note": {
            "type": "string",
            "maxLength": 400
          },
          "step": {
            "enum": [
              "userOutbox",
              "externalAdmission",
              "cloudTaskPull",
              "botHeldInbox",
              "missedRoutines",
              "connectorScan",
              "approvalReminderSync"
            ]
          },
          "remainingMs": {
            "type": "integer",
            "minimum": 0
          },
          "expected": {
            "enum": [
              "run",
              "skip"
            ]
          }
        }
      }
    },
    "invalidSweepVectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "input",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "note": {
            "type": "string",
            "maxLength": 400
          },
          "input": {
            "type": "object"
          },
          "reason": {
            "enum": [
              "missing-member",
              "member-type",
              "unknown-step",
              "remaining-negative"
            ]
          }
        }
      }
    }
  }
}

{
  "title": "HostSendOutboxEntry v1",
  "description": "One durable send-outbox entry of the host. The rpcId is a lowercase UUIDv4 generated at enqueue and is the idempotency key of the user message; the entry is deleted only after an authoritative user_message with that source.rpcId has been observed. Text may be empty only when attachments is non-empty; a text-only entry keeps minLength 1. Optional attachments are references plus metadata, never inline bytes: bytes live under send-outbox/attachments/<rpcId>/<attachmentId> in the same durable app-container tree, not in Library/Caches and not in /dsh/tmp. The bound of 20 mirrors the host-declared per-message image limit. The state machine, store lifecycle and crash rules are fixed by spec/host/v1/README.md section 10 and docs/protocol-changes/PC-20261112-w1-browse-outbox.md (Rev 4).",
  "type": "object",
  "oneOf": [
    {
      "description": "A text prompt (non-empty text) with zero or more attachments.",
      "type": "object",
      "required": [
        "v",
        "rpcId",
        "sessionId",
        "text",
        "createdAtMs",
        "state",
        "attempts"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "rpcId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,64}$"
        },
        "createdAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "enum": [
            "queued",
            "submitting",
            "accepted",
            "durable",
            "outcomeUnknown"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "lastError": {
          "type": "string",
          "maxLength": 1024
        },
        "acceptedAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "durableAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "outcomeUnknownAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "backend": {
          "enum": [
            "local",
            "pc"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        },
        "attachments": {
          "description": "Optional attachment references. Ordered; at most 20, mirroring the host-declared per-message image limit (maxImagesPerMessage, fallback 20). The bytes are outbox-owned files referenced by storePath; no inline bytes or dataBase64 member is allowed.",
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "byteSize",
              "sha256",
              "contentType",
              "filename",
              "storePath"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]{1,64}$"
              },
              "kind": {
                "enum": [
                  "image",
                  "file",
                  "audio",
                  "video",
                  "document"
                ]
              },
              "byteSize": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "contentType": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "filename": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "storePath": {
                "type": "string",
                "pattern": "^attachments/[0-9a-f-]{36}/[A-Za-z0-9._-]{1,64}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Attachment-only send: text is empty and at least one attachment is present.",
      "type": "object",
      "required": [
        "v",
        "rpcId",
        "sessionId",
        "text",
        "createdAtMs",
        "state",
        "attempts",
        "attachments"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "rpcId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,64}$"
        },
        "createdAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "enum": [
            "queued",
            "submitting",
            "accepted",
            "durable",
            "outcomeUnknown"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "lastError": {
          "type": "string",
          "maxLength": 1024
        },
        "acceptedAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "durableAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "outcomeUnknownAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "backend": {
          "enum": [
            "local",
            "pc"
          ]
        },
        "text": {
          "const": ""
        },
        "attachments": {
          "description": "Optional attachment references. Ordered; at most 20, mirroring the host-declared per-message image limit (maxImagesPerMessage, fallback 20). The bytes are outbox-owned files referenced by storePath; no inline bytes or dataBase64 member is allowed.",
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "byteSize",
              "sha256",
              "contentType",
              "filename",
              "storePath"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]{1,64}$"
              },
              "kind": {
                "enum": [
                  "image",
                  "file",
                  "audio",
                  "video",
                  "document"
                ]
              },
              "byteSize": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "contentType": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "filename": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "storePath": {
                "type": "string",
                "pattern": "^attachments/[0-9a-f-]{36}/[A-Za-z0-9._-]{1,64}$"
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    }
  ]
}

{
  "title": "HarnessCapabilities",
  "description": "What a harness backend supports. The host must not offer an action the backend cannot honour. A session may narrow, never widen, the backend's static set.",
  "type": "object",
  "required": [
    "cancel",
    "steer",
    "resume",
    "permission",
    "client_tools",
    "tool_visibility",
    "runs_while_app_suspended"
  ],
  "properties": {
    "cancel": {
      "type": "boolean"
    },
    "steer": {
      "type": "boolean"
    },
    "resume": {
      "type": "string",
      "enum": [
        "native",
        "replay",
        "none"
      ]
    },
    "permission": {
      "type": "string",
      "enum": [
        "native",
        "relay",
        "none"
      ]
    },
    "client_tools": {
      "type": "string",
      "enum": [
        "native",
        "bridge",
        "none"
      ]
    },
    "tool_visibility": {
      "type": "boolean"
    },
    "runs_while_app_suspended": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}

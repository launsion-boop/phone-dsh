          "const": "assistant_message"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "session_id",
        "seq",
        "time_ms",
        "kind",
        "call_id",
        "name",
        "arguments"
      ],
      "properties": {
        "session_id": {
          "type": "string",

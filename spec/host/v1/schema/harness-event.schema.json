{
  "title": "HarnessEvent",
  "description": "One event of a session stream. The envelope always carries session_id, time_ms and kind. seq is present exactly on durable events: durable events are replayed after a resume cursor and MUST be strictly increasing per session; an event without seq is best effort and is never replayed. kind is the only discriminator; each variant is closed so exactly one variant matches.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "session_id",
        "time_ms",
        "kind",
        "text"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "const": "assistant_delta"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "session_id",
        "time_ms",
        "kind",
        "text"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "const": "reasoning_delta"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    {

              "maxLength": 65536
            },
            "options": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "questions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "prompt",
                  "options",
                  "multiple"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "prompt": {
                    "type": "string",
                    "maxLength": 65536
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 4096
                    }
                  },
                  "multiple": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

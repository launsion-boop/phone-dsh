          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "const": "tool_call"
        },
        "call_id": {
          "type": "string",
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "arguments": {
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "session_id",
        "seq",
        "time_ms",
        "kind",
        "call_id",
        "is_error",
        "summary"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "const": "tool_result"
        },
        "call_id": {
          "type": "string",
          "maxLength": 256
        },
        "is_error": {
          "type": "boolean"
        },
        "summary": {
          "type": "string",
          "maxLength": 300
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "UTF-8 byte count of the tool output, when the producer measured it. Absent means not measured: a consumer shows unknown and MUST NOT substitute 0 (event-kinds.md §1.2)."
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Wall-clock duration of the tool call in whole milliseconds, when the producer measured it. Absent means not measured: a consumer shows unknown and MUST NOT substitute 0 (event-kinds.md §1.2). The 10 ms quantization of spec/v1/trajectory.md §5 is a projection rule, not a host rule."
        },
        "meta": {
          "type": "object",
          "description": "Producer-supplied JSON object about the result, passed through unparsed. Absent means none was reported: a consumer MUST NOT substitute an empty object (event-kinds.md §1.2)."
        },
        "tool_result_detail": {
          "type": "object",
          "required": [
            "text",
            "truncated",
            "event_seq",
            "session_log_path"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "truncated": {
              "type": "boolean"
            },
            "event_seq": {
              "type": "integer",
              "minimum": 0
            },
            "session_log_path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "session_id",
        "time_ms",
        "kind",
        "request"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "const": "permission_requested"
        },
        "request": {
          "type": "object",
          "required": [
            "request_id",
            "tool",
            "summary",
            "risk"
          ],
          "properties": {
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,127}$"
            },
            "tool": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "summary": {
              "type": "string",
              "maxLength": 4096
            },
            "risk": {
              "type": "string",
              "enum": [
                "read_only",
                "side_effect",
                "ui"
              ]
            },
            "expires_at_ms": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

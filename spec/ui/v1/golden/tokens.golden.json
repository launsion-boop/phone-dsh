      "unit": "pt",
      "drivers": {
        "ios": "dynamic-type",
        "android": "font-scale"
      },
      "rule": "渲染字号 = baseSize × 平台缩放系数;示例只声明系数来源,不写任何绝对像素值"
    },
    "styles": {
      "navTitle": {
        "baseSize": 17.5,
        "lineHeight": 22,

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spec/ui/v1/bot/schema/header-presence.schema.json",
  "title": "BotHeaderPresence v1 (P09 derived view value)",
  "type": "object",
  "required": [
    "phase",
    "line",
    "fishState",
    "motion",
    "workStyle"
  ],
  "properties": {
    "phase": {
      "enum": [
        "idle",
        "problem",
        "working",
        "waitingForYou"
      ]
    },
    "line": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "status",
            "detail",
            "category",
            "startedAt"
          ],
          "properties": {
            "status": {
              "enum": [
                "thinking",
                "tool-running",
                "streaming"
              ]
            },
            "detail": {
              "type": "string"
            },
            "category": {
              "enum": [
                "thinking",
                "reading",
                "searching",
                "browsing",
                "running",
                "writing",
                "memory",
                "messaging",
                "reviewing",
                "waiting",
                "replying",
                "generic"
              ]
            },
            "startedAt": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "fishState": {
      "enum": [
        "idle",
        "thinking",
        "streaming",
        "working",
        "sleeping",
        "alerting",
        "listening",
        "speaking",
        "happy",
        "sad",
        "surprised",
        "confused",
        "laughing",
        "love",
        "angry",
        "wink",
        "nod",
        "shrug",
        "celebrate",
        "poke",
        "waking",
        "waiting",
        "loading",
        "done",
        "standby",
        "spawning",
        "bouncing",
        "dancing",
        "waving",
        "shy",
        "smug",
        "crying",
        "sighing",
        "cheering",
        "bowing",
        "clapping",
        "stretching",
        "yawning",
        "kiss",
        "shaking-head",
        "high-five",
        "powering-down"
      ]
    },
    "motion": {
      "enum": [
        "standard",
        "lively"
      ]
    },
    "workStyle": {
      "enum": [
        "generic",
        "reading",
        "searching",
        "running",
        "writing"
      ]
    },
    "lineIsQuiet": {
      "type": "boolean"
    },
    "lineIsProblem": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}

      "androidOnly": {
        "reason": {
          "baselineLacks": "the iOS MCP editor is HTTP-only (`MCPSettingsPage.swift:193`): it has no transport concept, so there is no row to name",
          "androidNeeds": "the editor form is in place ahead of its transport; the host cannot run a stdio server today (`phone-mcp` accepts HTTP(S) only, and the App's SaveMcpServer is a disclosed no-op), so choosing stdio here ends in an honest refusal rather than a launch",
          "withoutIt": "a future stdio transport would have no UI to land in, and the editor could only ever describe an HTTP server"
        },
        "owner": "android-ui",
        "reviewBy": "2027-01-31"
      }
    },

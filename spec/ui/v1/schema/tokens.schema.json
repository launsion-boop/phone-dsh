{
  "title": "phone-dsh UI reference v1 — tokens document and signature-surface projection",
  "oneOf": [
    {
      "type": "object",
      "required": ["kind", "version", "colors", "typography", "spacing", "radius", "motion", "signatureSurfaces", "contrast", "provenance"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "tokens"},
        "version": {"const": 1},
        "note": {"type": "string", "maxLength": 400},
        "colors": {
          "type": "object",
          "required": ["primary", "secondary", "tertiary", "caption", "background", "input", "selector", "code", "codeBanner", "inlineCode", "border", "borderLight", "accent", "success", "danger", "warning", "onAccent"],
          "additionalProperties": {
            "type": "object",
            "required": ["light", "dark"],
            "additionalProperties": false,
            "properties": {
              "light": {
                "type": ["string", "null"],
                "pattern": "^#[0-9A-F]{6}$"
              },
              "dark": {
                "type": ["string", "null"],
                "pattern": "^#[0-9A-F]{6}$"
              },
              "note": {"type": "string", "maxLength": 240},
              "baselineInconsistency": {"type": "boolean"}
            }
          }
        },
        "typography": {
          "type": "object",
          "required": ["scale", "styles"],
          "additionalProperties": false,
          "properties": {
            "scale": {
              "type": "object",
              "required": ["mode", "unit", "drivers", "rule"],
              "additionalProperties": false,
              "properties": {
                "mode": {"const": "system"},
                "unit": {"const": "pt"},
                "drivers": {
                  "type": "object",
                  "required": ["ios", "android"],
                  "additionalProperties": false,
                  "properties": {
                    "ios": {
                      "enum": ["dynamic-type"]
                    },
                    "android": {
                      "enum": ["font-scale"]
                    }
                  }
                },
                "rule": {"type": "string", "minLength": 20, "maxLength": 300},
                "clamp": {
                  "type": "object",
                  "required": ["min", "max"],
                  "additionalProperties": false,
                  "properties": {
                    "min": {"type": "number", "minimum": 0.5, "maximum": 2},
                    "max": {
                      "type": ["number", "null"],
                      "minimum": 1,
                      "maximum": 4
                    }
                  }
                }
              }
            },
            "styles": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["baseSize", "weight", "mono", "role"],
                "additionalProperties": false,
                "properties": {
                  "baseSize": {"type": "integer", "minimum": 8, "maximum": 72},
                  "weight": {
                    "enum": [400, 500, 600, 700]
                  },
                  "mono": {"type": "boolean"},
                  "role": {
                    "enum": ["body", "label", "code", "caption", "control", "title"]
                  },
                  "note": {"type": "string", "maxLength": 240},
                  "needsDeviceMeasure": {"type": "boolean"}
                }
              }
            }
          }
        },
        "spacing": {
          "type": "object",
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 64}
        },
        "radius": {
          "type": "object",
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 64}
        },
        "stroke": {
          "type": "object",
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 8}
        },
        "motion": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["durationMs", "curve", "repeat"],
            "additionalProperties": false,
            "properties": {
              "durationMs": {"type": "integer", "minimum": 0, "maximum": 60000},
              "curve": {
                "enum": ["linear", "easeOut", "easeInOut"]
              },
              "repeat": {
                "enum": ["once", "forever"]
              },
              "note": {"type": "string", "maxLength": 200}
            }
          }
        },
        "signatureSurfaces": {
          "type": "object",
          "required": ["bubble", "toolRow", "thinkingPill", "approvalCard", "composer", "failLoudBanner"],
          "additionalProperties": false,
          "properties": {
            "bubble": {
              "type": "object",
              "required": ["surface", "parity", "tokens", "typographyUnmeasured", "unmeasured"],
              "additionalProperties": false,
              "properties": {
                "surface": {"const": "bubble"},
                "typographyUnmeasured": {"type": "boolean"},
                "parity": {
                  "enum": ["pixel", "deferred"]
                },
                "tokens": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 24,
                  "items": {"type": "string", "pattern": "^(colors|geometry|typography|spacing|radius|stroke|motion)\\.[A-Za-z][A-Za-z0-9]*$"}
                },
                "unmeasured": {
                  "type": "array",
                  "maxItems": 12,
                  "items": {"type": "string", "minLength": 4, "maxLength": 200}
                },
                "note": {"type": "string", "maxLength": 300}
              }
            },
            "toolRow": {
              "type": "object",
              "required": ["surface", "parity", "tokens", "typographyUnmeasured", "unmeasured"],
              "additionalProperties": false,
              "properties": {
                "surface": {"const": "toolRow"},
                "typographyUnmeasured": {"type": "boolean"},
                "parity": {
                  "enum": ["pixel", "deferred"]
                },
                "tokens": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 24,
                  "items": {"type": "string", "pattern": "^(colors|geometry|typography|spacing|radius|stroke|motion)\\.[A-Za-z][A-Za-z0-9]*$"}
                },
                "unmeasured": {
                  "type": "array",
                  "maxItems": 12,
                  "items": {"type": "string", "minLength": 4, "maxLength": 200}
                },
                "note": {"type": "string", "maxLength": 300}
              }
            },
            "thinkingPill": {
              "type": "object",
              "required": ["surface", "parity", "tokens", "typographyUnmeasured", "unmeasured"],
              "additionalProperties": false,
              "properties": {
                "surface": {"const": "thinkingPill"},
                "typographyUnmeasured": {"type": "boolean"},
                "parity": {
                  "enum": ["pixel", "deferred"]
                },
                "tokens": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 24,
                  "items": {"type": "string", "pattern": "^(colors|geometry|typography|spacing|radius|stroke|motion)\\.[A-Za-z][A-Za-z0-9]*$"}
                },
                "unmeasured": {
                  "type": "array",
                  "maxItems": 12,
                  "items": {"type": "string", "minLength": 4, "maxLength": 200}
                },
                "note": {"type": "string", "maxLength": 300}
              }
            },
            "approvalCard": {
              "type": "object",
              "required": ["surface", "parity", "tokens", "typographyUnmeasured", "unmeasured"],
              "additionalProperties": false,
              "properties": {
                "surface": {"const": "approvalCard"},
                "typographyUnmeasured": {"type": "boolean"},
                "parity": {
                  "enum": ["pixel", "deferred"]
                },
                "tokens": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 24,
                  "items": {"type": "string", "pattern": "^(colors|geometry|typography|spacing|radius|stroke|motion)\\.[A-Za-z][A-Za-z0-9]*$"}
                },
                "unmeasured": {
                  "type": "array",
                  "maxItems": 12,
                  "items": {"type": "string", "minLength": 4, "maxLength": 200}
                },
                "note": {"type": "string", "maxLength": 300}
              }
            },
            "composer": {
              "type": "object",
              "required": ["surface", "parity", "tokens", "typographyUnmeasured", "unmeasured"],
              "additionalProperties": false,
              "properties": {
                "surface": {"const": "composer"},
                "typographyUnmeasured": {"type": "boolean"},
                "parity": {
                  "enum": ["pixel", "deferred"]
                },
                "tokens": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 24,
                  "items": {"type": "string", "pattern": "^(colors|geometry|typography|spacing|radius|stroke|motion)\\.[A-Za-z][A-Za-z0-9]*$"}
                },
                "unmeasured": {
                  "type": "array",
                  "maxItems": 12,
                  "items": {"type": "string", "minLength": 4, "maxLength": 200}
                },
                "note": {"type": "string", "maxLength": 300}
              }
            },
            "failLoudBanner": {
              "type": "object",
              "required": ["surface", "parity", "tokens", "typographyUnmeasured", "unmeasured"],
              "additionalProperties": false,
              "properties": {
                "surface": {"const": "failLoudBanner"},
                "typographyUnmeasured": {"type": "boolean"},
                "parity": {
                  "enum": ["pixel", "deferred"]
                },
                "tokens": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 24,
                  "items": {"type": "string", "pattern": "^(colors|geometry|typography|spacing|radius|stroke|motion)\\.[A-Za-z][A-Za-z0-9]*$"}
                },
                "unmeasured": {
                  "type": "array",
                  "maxItems": 12,
                  "items": {"type": "string", "minLength": 4, "maxLength": 200}
                },
                "note": {"type": "string", "maxLength": 300}
              }
            }
          }
        },
        "contrast": {
          "type": "object",
          "required": ["roles", "pairs", "exempt"],
          "additionalProperties": false,
          "properties": {
            "roles": {
              "type": "object",
              "required": ["body", "large", "nonText"],
              "additionalProperties": false,
              "properties": {
                "body": {"const": 4.5},
                "large": {"const": 3.0},
                "nonText": {"const": 3.0}
              }
            },
            "pairs": {
              "type": "array",
              "minItems": 4,
              "items": {
                "type": "object",
                "required": ["id", "foreground", "background", "role", "required", "sites"],
                "additionalProperties": false,
                "properties": {
                  "id": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*/[a-z][A-Za-z0-9]*$"},
                  "foreground": {"type": "string", "pattern": "^[a-zA-Z][A-Za-z0-9]*$"},
                  "background": {"type": "string", "pattern": "^[a-zA-Z][A-Za-z0-9]*$"},
                  "role": {
                    "enum": ["body", "large", "nonText"]
                  },
                  "required": {"type": "boolean"},
                  "sites": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 6,
                    "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*\\.swift:[0-9]+$"}
                  },
                  "note": {"type": "string", "maxLength": 300},
                  "owner": {"type": "string", "minLength": 3, "maxLength": 120},
                  "reviewBy": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
                  "debtReason": {"type": "string", "minLength": 12, "maxLength": 300}
                }
              }
            },
            "exempt": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["token", "reason"],
                "additionalProperties": false,
                "properties": {
                  "token": {"type": "string", "pattern": "^[a-zA-Z][A-Za-z0-9]*$"},
                  "reason": {
                    "enum": ["dynamic", "decorative", "composite"]
                  },
                  "note": {"type": "string", "maxLength": 240}
                }
              }
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["source", "tier"],
            "additionalProperties": false,
            "properties": {
              "source": {"type": "string", "pattern": "^(unmeasured|system:[A-Za-z0-9 .,'()#-]+|platform default, not measured in this repo|[A-Za-z][A-Za-z0-9]*\\.swift:[0-9]+)$"},
              "tier": {
                "enum": ["theme", "component", "page", "system", "unmeasured"]
              },
              "note": {"type": "string", "maxLength": 240},
              "needsDeviceMeasure": {"type": "boolean"}
            }
          }
        },
        "geometry": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["value", "unit", "scalesWith"],
            "additionalProperties": false,
            "properties": {
              "value": {"type": "number", "minimum": 0.05, "maximum": 2000},
              "unit": {
                "enum": ["pt", "screenRatio"]
              },
              "scalesWith": {
                "type": ["string", "null"],
                "pattern": "^typography\\.[A-Za-z][A-Za-z0-9]*$"
              },
              "note": {"type": "string", "maxLength": 240}
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["kind", "version", "events", "rows", "note"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "surface-projection"},
        "version": {"const": 1},
        "note": {"type": "string", "maxLength": 400},
        "events": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["seq", "type", "data"],
            "additionalProperties": false,
            "properties": {
              "seq": {"type": "integer", "minimum": 1, "maximum": 1000000},
              "type": {"type": "string", "minLength": 3, "maxLength": 64},
              "data": {"type": "object"}
            }
          }
        },
        "rows": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "required": ["row", "surface", "state", "tokens"],
            "additionalProperties": false,
            "properties": {
              "row": {"type": "string", "minLength": 2, "maxLength": 40},
              "surface": {
                "enum": ["bubble", "toolRow", "thinkingPill", "approvalCard", "composer", "failLoudBanner"]
              },
              "state": {"type": "string", "minLength": 2, "maxLength": 40},
              "collapsed": {"type": "boolean"},
              "tokens": {
                "type": "array",
                "minItems": 1,
                "maxItems": 24,
                "items": {"type": "string", "pattern": "^(colors|geometry|typography|spacing|radius|stroke|motion)\\.[A-Za-z][A-Za-z0-9]*$"}
              }
            }
          }
        }
      }
    }
  ]
}

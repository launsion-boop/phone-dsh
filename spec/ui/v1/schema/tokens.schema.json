        },
        "contrast": {
          "type": "object",
          "required": [
            "roles",
            "pairs",
            "exempt"
          ],
          "additionalProperties": false,
          "properties": {
            "roles": {
              "type": "object",
              "required": [
                "body",
                "large",
                "nonText"
              ],
              "additionalProperties": false,
              "properties": {
                "body": {
                  "const": 4.5
                },
                "large": {
                  "const": 3.0
                },
                "nonText": {
                  "const": 3.0
                }
              }
            },
            "pairs": {
              "type": "array",
              "minItems": 4,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "foreground",
                  "background",
                  "role",
                  "required",
                  "sites"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][A-Za-z0-9]*/[a-z][A-Za-z0-9]*$"
                  },
                  "foreground": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][A-Za-z0-9]*$"
                  },
                  "background": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][A-Za-z0-9]*$"
                  },
                  "role": {
                    "enum": [
                      "body",
                      "large",
                      "nonText"
                    ]
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "sites": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 6,
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9]*\\.swift:[0-9]+$"
                    }
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "owner": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 120
                  },
                  "reviewBy": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                  },
                  "debtReason": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 300
                  }
                }
              }
            },
            "exempt": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "token",
                  "reason"
                ],
                "additionalProperties": false,
                "properties": {
                  "token": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][A-Za-z0-9]*$"
                  },
                  "reason": {
                    "enum": [
                      "dynamic",
                      "decorative",
                      "composite"
                    ]
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 240
                  }
                }
              }
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "source",
              "tier"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "pattern": "^(unmeasured|system:[A-Za-z0-9 .,'()#-]+|platform default, not measured in this repo|Sources/PhoneDSH/Background/TaskScreen\\.swift:[0-9]+|[A-Za-z][A-Za-z0-9]*\\.swift:[0-9]+)$"
              },
              "tier": {
                "enum": [
                  "theme",
                  "component",
                  "page",
                  "system",
                  "unmeasured"
                ]
              },
              "note": {
                "type": "string",
                "maxLength": 240
              },
              "needsDeviceMeasure": {
                "type": "boolean"
              },
              "expect": {
                "type": "string",
                "minLength": 3,
                "maxLength": 120,
                "description": "Optional literal snippet the cited source line must still contain. page-layer lengths and motion use it because the token name is not a Swift identifier on that line."
              }
            }
          }
        },
        "geometry": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "value",
              "unit",
              "scalesWith"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 2000,
                "description": "0 is a legal length (it means 'no inset'). Rule change L22 2026-11-01: the minimum used to be 0.05, which forced a fake value for a real 0 (commit 86a39aac sets composerOuterMarginBottom to 0); the floor is 0 now, negative lengths stay invalid."
              },
              "unit": {
                "enum": [
                  "pt",
                  "screenRatio"
                ]
              },
              "scalesWith": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^typography\\.[A-Za-z][A-Za-z0-9]*$"
              },
              "note": {
                "type": "string",
                "maxLength": 240
              }
            }
          }
        },
        "aliases": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^(colors|geometry|typography|spacing|radius|stroke|motion)\\.[A-Za-z][A-Za-z0-9]*$"
            }
          }
        },
        "shadows": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "opacity",
              "radius",
              "y",
              "source",
              "note"
            ],
            "additionalProperties": false,
            "properties": {
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "radius": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "y": {
                "type": "number",
                "minimum": -100,
                "maximum": 100
              },
              "x": {
                "type": "number",
                "minimum": -100,
                "maximum": 100,
                "description": "Horizontal shadow offset in pt. Optional; defaults to 0 when absent, matching SwiftUI's shadow y-only default. The drawer shadow sets x: 6, y: 0."
              },
              "source": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9]*\\.swift:[0-9]+"
              },
              "note": {
                "type": "string",
                "maxLength": 240
              }
            }
          }
        },
        "componentCompatibility": {
          "type": "object",
          "description": "Active platform component roles kept distinct from canonical HomeSpec signature inventories.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "tokens",
              "note"
            ],
            "additionalProperties": false,
            "properties": {
              "tokens": {
                "type": "array",
                "minItems": 1,
                "maxItems": 24,
                "items": {
                  "type": "string",
                  "pattern": "^(colors|geometry|typography|spacing|radius|stroke|motion)\\.[A-Za-z][A-Za-z0-9]*$"
                }
              },
              "note": {
                "type": "string",
                "maxLength": 240
              }
            }
          }
        },
        "componentMetrics": {
          "type": "object",
          "description": "Non-token HomeSpec behaviour values generated into HomeSpecData from their owning source.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "value",
              "unit",
              "source",
              "expect",
              "note"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "unit": {
                "const": "opacity"
              },
              "source": {
                "type": "string",
                "pattern": "^HomeSpec\\.swift:[0-9]+$"
              },
              "expect": {
                "type": "string",
                "minLength": 3,
                "maxLength": 120
              },
              "note": {
                "type": "string",
                "maxLength": 240
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "kind",
        "version",
        "events",
        "rows",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "surface-projection"
        },
        "version": {
          "const": 1
        },
        "note": {
          "type": "string",
          "maxLength": 400
        },
        "events": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "seq",
              "type",
              "data"
            ],
            "additionalProperties": false,
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "type": {
                "type": "string",
                "minLength": 3,
                "maxLength": 64
              },
              "data": {
                "type": "object"
              }
            }
          }
        },
        "rows": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "required": [
              "row",
              "surface",
              "state",
              "tokens"
            ],
            "additionalProperties": false,
            "properties": {
              "row": {
                "type": "string",
                "minLength": 2,
                "maxLength": 40
              },
              "surface": {
                "enum": [
                  "bubble",
                  "toolRow",
                  "thinkingPill",
                  "approvalCard",
                  "composer",
                  "failLoudBanner"
                ]
              },
              "state": {
                "type": "string",
                "minLength": 2,
                "maxLength": 40
              },
              "collapsed": {
                "type": "boolean"
              },
              "tokens": {
                "type": "array",
                "minItems": 1,
                "maxItems": 24,
                "items": {
                  "type": "string",
                  "pattern": "^(colors|geometry|typography|spacing|radius|stroke|motion)\\.[A-Za-z][A-Za-z0-9]*$"
                }
              }
            }
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PCLink v1 relay.ready",
  "type": "object",
  "required": ["v", "type", "machineId", "role"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "type": { "const": "relay.ready" },
    "machineId": { "type": "string", "pattern": "^[a-z2-7]{26}$" },
    "role": { "enum": ["phone", "pc"] }
  }
}

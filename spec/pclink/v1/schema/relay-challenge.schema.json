{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PCLink v1 relay.challenge",
  "type": "object",
  "required": [
    "v",
    "type",
    "nonce",
    "relay"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "const": "relay.challenge"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "relay": {
      "type": "string",
      "pattern": "^https?://[a-z0-9][a-z0-9.-]*(?::[0-9]{1,5})?$"
    }
  }
}

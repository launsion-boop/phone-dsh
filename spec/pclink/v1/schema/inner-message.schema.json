{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PCLink v1 inner message (AEAD plaintext)",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "v",
        "type",
        "role",
        "caps",
        "dsh",
        "app",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "peer.hello"
        },
        "role": {
          "enum": [
            "phone",
            "pc"
          ]
        },
        "caps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]{1,64}$"
          }
        },
        "dsh": {
          "type": "object",
          "required": [
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{7,64}$"
            }
          }
        },
        "app": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u2064\\u2066-\\u206f\\ufeff]+$",
              "$comment": "1-64 UTF-8 bytes, NFC, no C0/C1/Cf (e.g. U+202E). JSON Schema counts code points; implementations MUST also enforce the 64-byte UTF-8 limit and reject non-NFC."
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9A-Za-z.+-]{1,32}$"
            }
          }
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u2064\\u2066-\\u206f\\ufeff]+$",
          "$comment": "1-64 UTF-8 bytes, NFC, no C0/C1/Cf (e.g. U+202E). JSON Schema counts code points; implementations MUST also enforce the 64-byte UTF-8 limit and reject non-NFC."
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "id",
        "endpoint",
        "args"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "rpc.call"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,64}$"
        },
        "endpoint": {
          "type": "string",
          "pattern": "^\\$?[A-Za-z][A-Za-z0-9.]*(/[A-Za-z][A-Za-z0-9.]*)?$"
        },
        "args": {
          "type": "object"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "id",
        "ok",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "rpc.result"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,64}$"
        },
        "ok": {
          "const": true
        },
        "result": {}
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "id",
        "ok",
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "rpc.result"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,64}$"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_$][A-Za-z0-9_$./:-]{0,127}$"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "details": {
              "type": "object"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "id",
        "part",
        "last",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "rpc.result.chunk"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,64}$"
        },
        "part": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "last": {
          "type": "boolean"
        },
        "data": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 1,
          "maxLength": 1500000
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "streamId",
        "endpoint",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "rpc.stream.open"
        },
        "streamId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,64}$"
        },
        "endpoint": {
          "type": "string",
          "pattern": "^\\$?[A-Za-z][A-Za-z0-9.]*(/[A-Za-z][A-Za-z0-9.]*)?$"
        },
        "payload": {
          "type": "object",
          "required": [
            "args"
          ],
          "additionalProperties": false,
          "properties": {
            "args": {
              "type": "object"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "streamId",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "rpc.stream.item"
        },
        "streamId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,64}$"
        },
        "value": {}
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "streamId",
        "part",
        "last",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "rpc.stream.chunk"
        },
        "streamId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,64}$"
        },
        "part": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "last": {
          "type": "boolean"
        },
        "data": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 1,
          "maxLength": 1500000
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "streamId"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "rpc.stream.end"
        },
        "streamId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,64}$"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "streamId",
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "rpc.stream.error"
        },
        "streamId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,64}$"
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_$][A-Za-z0-9_$./:-]{0,127}$"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "details": {
              "type": "object"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "streamId"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "rpc.stream.cancel"
        },
        "streamId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,64}$"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "code"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "session.close"
        },
        "code": {
          "enum": [
            "unavailable",
            "unpaired",
            "auth_failed",
            "replaced",
            "session_expired",
            "replay",
            "bad_frame",
            "frame_too_large",
            "rate_limited",
            "version_unsupported",
            "rekey"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 0,
          "maxLength": 512
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "kind",
        "name",
        "fingerprint",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "pclink.notice"
        },
        "kind": {
          "const": "paired"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u2064\\u2066-\\u206f\\ufeff]+$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-z2-7]{4}-[a-z2-7]{4}-[a-z2-7]{4}$"
        },
        "at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "code"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^(?:task|call)\\.[A-Za-z][A-Za-z0-9._-]{0,63}\\.error$"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,64}$"
        },
        "code": {
          "const": "unavailable"
        },
        "message": {
          "type": "string",
          "minLength": 0,
          "maxLength": 512
        }
      }
    }
  ],
  "$comment": "String maxLength counts code points; the normative name limit is 1-64 UTF-8 bytes, NFC, no C0/C1/Cf. DSH passthrough values (rpc.call.args, rpc.stream.open.payload.args, rpc.result.result, rpc.stream.item.value, and the decoded rpc.result.chunk.data/rpc.stream.chunk.data) are unconstrained JSON values: a decoded U+0000 from a legal JSON \\u0000 escape is data and MUST NOT be filtered or rejected as a framing error (README §2.3)."
}

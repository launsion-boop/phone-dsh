{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PCLink v1 peer.auth (relay plane)",
  "type": "object",
  "required": ["v", "type", "machineId", "publicKey", "role", "sig"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "type": { "const": "peer.auth" },
    "machineId": { "type": "string", "pattern": "^[a-z2-7]{26}$" },
    "publicKey": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "role": { "enum": ["phone", "pc"] },
    "sig": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
  }
}

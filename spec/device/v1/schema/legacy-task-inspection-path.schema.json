{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Legacy task inspection path vector",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "components_hex", "valid", "escaped"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "components_hex": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^([0-9a-f]{2})*$"}},
    "valid": {"type": "boolean"},
    "escaped": {"type": ["string", "null"]}
  }
}

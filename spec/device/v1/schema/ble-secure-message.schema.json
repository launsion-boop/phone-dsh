        "v",
        "t",
        "seq",
        "device",
        "phone",
        "eid",
        "cc"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "t": {
          "const": "ready_req"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "device": {
          "type": "string",
          "pattern": "^ble:[0-9a-f]{64}$"
        },
        "phone": {
          "type": "string",
          "pattern": "^phone:[0-9a-f]{64}$"
        },
        "eid": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "cc": {

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Legacy task inspection scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "scenario", "expected"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "scenario": {"enum": ["absent", "ordinary", "mixed", "malformed", "orphan", "symlink", "fifo", "hardlink-lock", "active-owner", "pending-init", "concurrent-scan", "budget", "cancel", "replace"]},
    "expected": {"enum": ["incomplete", "busy"]}
  }
}

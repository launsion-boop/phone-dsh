{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "secure-session-v1 peer certificate acceptance vector",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "role",
    "chain_hex",
    "pin",
    "spki_point_hex",
    "accept"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "role": {
      "enum": [
        "device",
        "phone"
      ]
    },
    "chain_hex": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "pattern": "^([0-9a-f]{2})+$"
      }
    },
    "pin": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "spki_point_hex": {
      "type": "string",
      "pattern": "^([0-9a-f]{2})+$"
    },
    "accept": {
      "type": "boolean"
    },
    "reason": {
      "enum": [
        "pin_mismatch",
        "curve",
        "ca_true",
        "eku_present",
        "key_usage",
        "unknown_critical_extension",
        "bad_self_signature",
        "chain_length",
        "no_certificate",
        "oversize",
        "malformed",
        "signature_algorithm"
      ]
    }
  }
}

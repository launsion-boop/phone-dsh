{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "secure-session-v2 pre-authentication LE CoC receive vector (ble-secure-session.md §5)",
  "description": "Board receive path with a fake L2CAP below it. initial_credits = rx_kframes; credits = LE Flow Control Credit the board sends after the step; close = the board disconnects the CoC (never the LE link).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "given",
    "initial_credits",
    "steps"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "given": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mtu",
        "mps",
        "rx_kframes"
      ],
      "properties": {
        "mtu": {
          "type": "integer",
          "minimum": 256,
          "maximum": 65535
        },
        "mps": {
          "type": "integer",
          "minimum": 23,
          "maximum": 65533
        },
        "rx_kframes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "initial_credits": {
      "type": "integer",
      "minimum": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "peer",
          "expect"
        ],
        "properties": {
          "peer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "enum": [
                  "kframe",
                  "consume"
                ]
              },
              "sdu_len": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "payload_len": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              }
            }
          },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "credits",
              "close",
              "delivered"
            ],
            "properties": {
              "credits": {
                "type": "integer",
                "minimum": 0
              },
              "close": {
                "enum": [
                  "credit_overrun",
                  "kframe_oversize",
                  "sdu_oversize",
                  "sdu_empty",
                  "sdu_overrun",
                  null
                ]
              },
              "delivered": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    }
  }
}

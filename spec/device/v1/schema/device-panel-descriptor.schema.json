{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Device panel descriptor v1 (device-panel.md §4)",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "device_id", "controls"],
  "properties": {
    "v": {"type": "integer", "const": 1},
    "device_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "[^\\u0000-\\u001F\\u007F]+"},
    "title": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "[^\\u0000-\\u001F\\u007F]+"},
    "controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "label"],
        "properties": {
          "tool": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "[^\\u0000-\\u001F\\u007F]+"},
          "label": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "[^\\u0000-\\u001F\\u007F]+"},
          "group": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "[^\\u0000-\\u001F\\u007F]+"},
          "preset": {"type": "object"}
        }
      }
    }
  }
}

{
  "title": "Android Link channel transition vector",
  "type": "object",
  "required": ["name", "steps"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["in", "out"], "additionalProperties": false,
        "properties": {
          "in": {"enum": ["open", "write_ok", "stale_write_ok", "write_error", "hello_ack_tools", "hello_ack_legacy", "hello_nak", "status", "tool", "status_response", "wrong_id", "wrong_opcode", "event", "timeout", "cancel", "bad_crc", "nak"]},
          "out": {"type": "array", "items": {"enum": ["write", "ready_tools", "ready_legacy", "reject", "complete", "event", "unknown", "disconnect", "nak"]}}
        }
      }
    }
  }
}

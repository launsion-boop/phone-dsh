{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Device panel inputSchema-to-editor mapping vector (device-panel.md §2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "input_schema",
    "render",
    "editors"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "[a-z0-9_]+"
    },
    "input_schema": {},
    "render": {
      "type": "string",
      "enum": [
        "editors",
        "agent_only"
      ]
    },
    "editors": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "arg",
              "kind",
              "required"
            ],
            "properties": {
              "arg": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "const": "toggle"
              },
              "required": {
                "type": "boolean"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "arg",
              "kind",
              "required",
              "integer",
              "min",
              "max"
            ],
            "properties": {
              "arg": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "const": "slider"
              },
              "required": {
                "type": "boolean"
              },
              "integer": {
                "type": "boolean"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "arg",
              "kind",
              "required",
              "options"
            ],
            "properties": {
              "arg": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "const": "picker"
              },
              "required": {
                "type": "boolean"
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20
              }
            }
          }
        ]
      }
    }
  }
}

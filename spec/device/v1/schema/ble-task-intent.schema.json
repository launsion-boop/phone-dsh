{
  "title": "BLE device task Link transition intent",
  "type": "object",
  "required": [
    "v",
    "msg_id",
    "device_id",
    "task_id",
    "action",
    "request_id",
    "idem_key",
    "arguments_sha256"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "msg_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^ble:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "action": {
      "enum": [
        "accept",
        "complete",
        "fail"
      ]
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "idem_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "arguments_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}

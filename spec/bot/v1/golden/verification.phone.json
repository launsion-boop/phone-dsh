  "upstream": [],
  "delta": [
    "P26 Task completion and independent verification (S3)"
  ],
  "policy": {
    "presetId": "pdsh-verifier",
    "principalKind": "verifier",
    "budgetRatio": 0.3,
    "tools": [
      "read",
      "grep",
      "glob",
      "bash"
    ],
    "hiddenGlobalTools": true,
    "deniedTools": [
      "write",
      "edit",
      "apply_patch",
      "SendToUser",
      "SendToAgent",
      "CreateTeammate",
      "Task",
      "AwaitTask",
      "StopSubagent",
      "UpdateMemory",
      "RecallMemory",
      "UpdateRoutine",
      "ListRoutines",
      "RequestApproval",
      "web_fetch",
      "web_search",
      "job_list",
      "job_output",
      "job_kill",
      "todo_write",
      "create_goal",
      "get_goal",
      "update_goal"
    ],
    "bash": {
      "allowed": [
        "cat notes.md",
        "ls -la",
        "grep -R RUN-MARKER .",
        "git diff --stat",
        "git status",
        "phone record search RUN-MARKER --session gb-task-abc",
        "phone record read record://session/gb-task-abc#2 --around 2"
      ],
      "denied": [
        "printf x > out.txt",
        "rm -rf build",
        "cat a | tee b",
        "curl https://example.com",
        "phone record search x; rm -rf .",
        "git checkout -- .",
        "python3 -c 'print(1)'",
        "sed -i s/a/b/ notes.md",
        "find . -delete",
        "env",
        "cat a && cat b",
        "echo $(whoami)"
      ]
    }
  },

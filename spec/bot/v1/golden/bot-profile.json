      },
      {
        "name": "empty_roster_has_no_main",
        "records": [],
        "mainAgentId": null,
        "expectedMainAgentId": null
      }
    ],
    "deleteMainMigration": [
      {
        "name": "deleting_main_moves_pointer_to_first_remaining",
        "records": [
          "agent-a",
          "agent-b",
          "agent-c"
        ],
        "mainAgentId": "agent-b",
        "deleteId": "agent-b",
        "expectedRemaining": [
          "agent-a",
          "agent-c"
        ],
        "expectedMainAgentId": "agent-a"
      },
      {
        "name": "deleting_non_main_keeps_pointer",
        "records": [
          "agent-a",
          "agent-b",
          "agent-c"
        ],
        "mainAgentId": "agent-c",
        "deleteId": "agent-b",
        "expectedRemaining": [
          "agent-a",
          "agent-c"
        ],
        "expectedMainAgentId": "agent-c"
      },
      {
        "name": "deleting_last_main_uses_first_remaining",
        "records": [
          "agent-a",
          "agent-b"
        ],
        "mainAgentId": "agent-b",
        "deleteId": "agent-b",
        "expectedRemaining": [
          "agent-a"
        ],
        "expectedMainAgentId": "agent-a"
      }
    ],

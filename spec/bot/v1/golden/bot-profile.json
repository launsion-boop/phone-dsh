  "rosterRules": {
    "mainPointerRepair": [
      {
        "name": "empty_pointer_uses_first_bot",
        "records": [
          "agent-a",
          "agent-b"
        ],
        "mainAgentId": null,
        "expectedMainAgentId": "agent-a"
      },
      {
        "name": "dangling_pointer_uses_first_bot",

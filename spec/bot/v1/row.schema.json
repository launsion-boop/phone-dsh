{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BotRow v1",
  "type": "object",
  "required": ["id", "botID", "seq", "updatedSeq", "kind", "body", "provenance", "streaming", "createdAt"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "botID": {"type": "string", "minLength": 1},
    "seq": {"type": "integer", "minimum": 0},
    "updatedSeq": {"type": "integer", "minimum": 0},
    "kind": {"enum": ["message", "sendMessage", "event"]},
    "role": {"type": "string"},
    "body": {"type": "object", "required": ["type"], "properties": {"type": {"enum": ["text", "widget", "attachment", "approval", "automation", "notice", "deleted"]}, "cardType": {"enum": ["question", "steps", "task", "document", "progress", "checklist", "link", "table", "callout", "info", "payload", "library"]}, "cardKey": {"type": "string", "maxLength": 64}}, "additionalProperties": true},
    "provenance": {"type": "object", "required": ["eventIDs", "trust", "tainted"], "properties": {"eventIDs": {"type": "array", "items": {"type": "string"}}, "trust": {"type": "string"}, "tainted": {"type": "boolean"}}, "additionalProperties": false},
    "streaming": {"type": "boolean"},
    "createdAt": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}

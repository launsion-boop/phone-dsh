{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BotObservationEnvelope v1",
  "description": "Decoded header of one system-generated observation envelope. The model-visible encoding is `<observation source=\"…\" origin=\"…\" at=\"…\" owner=\"…\" ref=\"…\">text</observation>`; see spec/bot/v1/README.md §4.3. `text` is the decoded body after unescaping.",
  "type": "object",
  "required": [
    "source",
    "origin",
    "at",
    "owner",
    "ref",
    "text"
  ],
  "additionalProperties": false,
  "properties": {
    "source": {
      "enum": [
        "tool",
        "connector",
        "device",
        "device-task",
        "web",
        "subagent",
        "agent",
        "attachment"
      ]
    },
    "origin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "ref": {
      "type": "string",
      "pattern": "^record://(session/(?!\\.{1,2}#)[A-Za-z0-9._-]{1,64}#(0|[1-9][0-9]*)|event/[1-9][0-9]*)$",
      "maxLength": 128
    },
    "text": {
      "type": "string",
      "maxLength": 262144
    },
    "truncated": {
      "type": "boolean"
    }
  }
}

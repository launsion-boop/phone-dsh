{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BotVolatileContext v1",
  "type": "object",
  "required": ["request", "response"],
  "properties": {
    "request": {
      "type": "object",
      "required": ["sessionId"],
      "properties": {
        "sessionId": {"type": "string", "minLength": 1, "maxLength": 200}
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["schemaVersion", "sessionId", "revision", "blocks"],
      "properties": {
        "schemaVersion": {"const": 1},
        "sessionId": {"type": "string", "minLength": 1, "maxLength": 200},
        "revision": {"type": "integer", "minimum": 1},
        "blocks": {
          "type": "object",
          "properties": {
            "variant": {"type": "string", "maxLength": 12000},
            "persona": {"type": "string", "maxLength": 12000},
            "memory": {"type": "string", "maxLength": 4000},
            "automation": {"type": "string", "maxLength": 4000}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BotMemoryWriteRequest v2",
  "description": "Arguments of UpdateMemory. Every mutating action carries the doc version it read (0 means the document must not exist).",
  "type": "object",
  "required": [
    "action",
    "path",
    "expected_version"
  ],
  "properties": {
    "action": {
      "enum": [
        "write",
        "append",
        "replace",
        "move",
        "delete",
        "restore"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "content": {
      "type": "string"
    },
    "find": {
      "type": "string",
      "minLength": 1
    },
    "replace": {
      "type": "string"
    },
    "to": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0
    },
    "restore_version": {
      "type": "integer",
      "minimum": 1
    },
    "evidence": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^record://(session/(?!\\.{1,2}#)[A-Za-z0-9._-]{1,64}#(0|[1-9][0-9]*)|event/[1-9][0-9]*)$",
            "maxLength": 128
          },
          {
            "const": "current-user-turn",
            "description": "Reserved value: the host resolves it to the user message that opened the current turn. Valid only in a real user turn; hidden, held, agent, routine, Task and maintainer turns cannot use it."
          }
        ]
      }
    },
    "marked_contradiction": {
      "type": "boolean",
      "description": "Set by a chat turn when this write records one side of a contradiction that later maintenance must resolve or mark uncertain."
    },
    "review": {
      "type": "object",
      "required": [
        "state",
        "basis"
      ],
      "description": "Writer-recorded check state (a model verification assertion with a resolvable basis, not a host certification of truth). Absent means no recorded judgment. verified requires a non-model basis and at least one resolvable ref; disputed requires the conflicting sides cited in refs. trust stays the separate question of who said it.",
      "properties": {
        "basis": {
          "enum": [
            "user-statement",
            "observation",
            "record-recheck",
            "model-inference"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "refs": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^record://(session/(?!\\.{1,2}#)[A-Za-z0-9._-]{1,64}#(0|[1-9][0-9]*)|event/[1-9][0-9]*)$",
                "maxLength": 128
              },
              {
                "const": "current-user-turn",
                "description": "Reserved value resolved by the host to the user message that opened this turn; only valid in a real user turn."
              }
            ]
          }
        },
        "state": {
          "enum": [
            "verified",
            "unverified",
            "disputed"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

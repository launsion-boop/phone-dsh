{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BotMemoryWriteRequest v2",
  "description": "Arguments of UpdateMemory. Every mutating action carries the doc version it read (0 means the document must not exist).",
  "type": "object",
  "required": ["action", "path", "expected_version"],
  "properties": {
    "action": {
      "enum": ["write", "append", "replace", "move", "delete", "restore"]
    },
    "path": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "content": {
      "type": "string"
    },
    "find": {
      "type": "string",
      "minLength": 1
    },
    "replace": {
      "type": "string"
    },
    "to": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0
    },
    "restore_version": {
      "type": "integer",
      "minimum": 1
    },
    "evidence": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^record://(session/(?!\\.{1,2}#)[A-Za-z0-9._-]{1,64}#(0|[1-9][0-9]*)|event/[1-9][0-9]*)$",
        "maxLength": 128
      }
    }
  },
  "additionalProperties": false
}

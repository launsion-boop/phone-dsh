{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BotDerivationView v1",
  "description": "Read-time derivation view: artifact -> carrier event -> source freshness. Never persisted. `state` is the worst source/upstream state (erased > revoked > changed > unavailable > unknown > current). `cycle-detected` turns the whole cycle unavailable. See spec/bot/v2/provenance.md §5.",
  "type": "object",
  "required": [
    "artifact",
    "state",
    "reasons",
    "sources",
    "review_effective",
    "generation"
  ],
  "properties": {
    "artifact": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "memory",
            "review",
            "routine",
            "proactive",
            "notification",
            "delivery",
            "suggestion",
            "draft",
            "skill"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "carrier": {
      "type": "string",
      "pattern": "^record://(session/(?!\\.{1,2}#)[A-Za-z0-9._-]{1,64}#(0|[1-9][0-9]*)|event/[1-9][0-9]*)$",
      "maxLength": 128
    },
    "state": {
      "enum": [
        "current",
        "changed",
        "unavailable",
        "revoked",
        "erased",
        "unknown"
      ]
    },
    "reasons": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": [
          "record-unresolved",
          "record-erased",
          "grant-revoked",
          "source-changed",
          "newer-observation-unversioned",
          "revision-basis-mismatch",
          "no-baseline",
          "source-version-unknown",
          "cycle-detected",
          "upstream-invalidated",
          "no-derivation",
          "no-skill-write-event",
          "scan-limit-exceeded"
        ]
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "record",
          "status"
        ],
        "properties": {
          "record": {
            "type": "string",
            "pattern": "^record://(session/(?!\\.{1,2}#)[A-Za-z0-9._-]{1,64}#(0|[1-9][0-9]*)|event/[1-9][0-9]*)$",
            "maxLength": 128
          },
          "role": {
            "enum": [
              "evidence",
              "review",
              "trigger",
              "creator",
              "recipient",
              "basis"
            ]
          },
          "status": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "BotSourceStatus v1",
            "description": "One host-derived current-state entry for a record:// source. Read-time only. `source_version` is the current record-derived version; `baseline` is the version captured when the artifact was written (optional; absent for legacy/no-baseline); `latest_ref` is the newest observation of the same source identity. `state`/`reasons` come from the single provenance resolver. `current` only means no known newer observation/revocation/erasure; it is not a verification. See spec/bot/v2/provenance.md §4.",
            "type": "object",
            "required": [
              "ref",
              "roles",
              "resolved",
              "erased",
              "state",
              "reasons",
              "observed_at_ms",
              "record_type",
              "trust"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^record://(session/(?!\\.{1,2}#)[A-Za-z0-9._-]{1,64}#(0|[1-9][0-9]*)|event/[1-9][0-9]*)$",
                "maxLength": 128
              },
              "roles": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "evidence",
                    "review",
                    "trigger",
                    "creator",
                    "recipient",
                    "basis"
                  ]
                }
              },
              "resolved": {
                "type": "boolean"
              },
              "erased": {
                "type": "boolean"
              },
              "state": {
                "enum": [
                  "current",
                  "changed",
                  "unavailable",
                  "revoked",
                  "erased",
                  "unknown"
                ]
              },
              "reasons": {
                "type": "array",
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "record-unresolved",
                    "record-erased",
                    "grant-revoked",
                    "source-changed",
                    "newer-observation-unversioned",
                    "revision-basis-mismatch",
                    "no-baseline",
                    "source-version-unknown",
                    "cycle-detected",
                    "scan-limit-exceeded"
                  ]
                }
              },
              "observed_at_ms": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "record_type": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 128
              },
              "trust": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "user",
                  "observation",
                  "assistant",
                  null
                ]
              },
              "source_version": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "basis",
                      "value"
                    ],
                    "properties": {
                      "basis": {
                        "enum": [
                          "content-sha256",
                          "provider-version",
                          "etag"
                        ]
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "observed_at_ms": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0
                      },
                      "basis_ref": {
                        "type": "string",
                        "pattern": "^record://(session/(?!\\.{1,2}#)[A-Za-z0-9._-]{1,64}#(0|[1-9][0-9]*)|event/[1-9][0-9]*)$",
                        "maxLength": 128
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": [
                      "reason"
                    ],
                    "properties": {
                      "reason": {
                        "enum": [
                          "record-unresolved",
                          "record-erased",
                          "record-without-content",
                          "source-unversioned",
                          "invalid-reference"
                        ]
                      },
                      "observed_at_ms": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0
                      },
                      "basis_ref": {
                        "type": "string",
                        "pattern": "^record://(session/(?!\\.{1,2}#)[A-Za-z0-9._-]{1,64}#(0|[1-9][0-9]*)|event/[1-9][0-9]*)$",
                        "maxLength": 128
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              },
              "latest_ref": {
                "type": "string",
                "pattern": "^record://(session/(?!\\.{1,2}#)[A-Za-z0-9._-]{1,64}#(0|[1-9][0-9]*)|event/[1-9][0-9]*)$",
                "maxLength": 128
              },
              "baseline": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "basis",
                      "value"
                    ],
                    "properties": {
                      "basis": {
                        "enum": [
                          "content-sha256",
                          "provider-version",
                          "etag"
                        ]
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "observed_at_ms": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0
                      },
                      "basis_ref": {
                        "type": "string",
                        "pattern": "^record://(session/(?!\\.{1,2}#)[A-Za-z0-9._-]{1,64}#(0|[1-9][0-9]*)|event/[1-9][0-9]*)$",
                        "maxLength": 128
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": [
                      "reason"
                    ],
                    "properties": {
                      "reason": {
                        "enum": [
                          "record-unresolved",
                          "record-erased",
                          "record-without-content",
                          "source-unversioned",
                          "invalid-reference"
                        ]
                      },
                      "observed_at_ms": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0
                      },
                      "basis_ref": {
                        "type": "string",
                        "pattern": "^record://(session/(?!\\.{1,2}#)[A-Za-z0-9._-]{1,64}#(0|[1-9][0-9]*)|event/[1-9][0-9]*)$",
                        "maxLength": 128
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "review_effective": {
      "type": "object",
      "required": [
        "state",
        "reasons"
      ],
      "properties": {
        "state": {
          "enum": [
            "verified",
            "unverified",
            "disputed",
            "unknown"
          ]
        },
        "reasons": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "record-unresolved",
              "record-erased",
              "grant-revoked",
              "source-changed",
              "newer-observation-unversioned",
              "revision-basis-mismatch",
              "no-baseline",
              "source-version-unknown",
              "cycle-detected",
              "upstream-invalidated",
              "no-derivation",
              "no-skill-write-event",
              "review-model-basis",
              "scan-limit-exceeded"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "upstream": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "artifact",
          "state"
        ],
        "properties": {
          "artifact": {
            "type": "object",
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "memory",
                  "review",
                  "routine",
                  "proactive",
                  "notification",
                  "delivery",
                  "suggestion",
                  "draft",
                  "skill"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "state": {
            "enum": [
              "current",
              "changed",
              "unavailable",
              "revoked",
              "erased",
              "unknown"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "generation": {
      "type": "object",
      "required": [
        "head_commit_seq",
        "last_erasure_seq",
        "last_grant_seq"
      ],
      "properties": {
        "head_commit_seq": {
          "type": "integer",
          "minimum": 0
        },
        "last_erasure_seq": {
          "type": "integer",
          "minimum": 0
        },
        "last_grant_seq": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BotContextObservationView v1",
  "description": "Read-time view of context observations for one Bot. Only the current consent generation and authorized/limited consent is active; a later revoke or a stale generation makes the item inactive and the old payload/body is not returned. See spec/bot/v2/context-sources.md §5.",
  "type": "object",
  "required": [
    "bot_id",
    "consent_generation",
    "items"
  ],
  "properties": {
    "bot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "consent_generation": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "source",
          "kind",
          "observed_at_ms",
          "source_version",
          "uncertainty",
          "state",
          "consent_generation"
        ],
        "properties": {
          "source": {
            "enum": [
              "calendar",
              "contacts",
              "selected-media",
              "location-fence",
              "power",
              "own-notification",
              "external-entry"
            ]
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "observed_at_ms": {
            "type": "integer",
            "minimum": 0
          },
          "source_version": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "basis",
                  "value"
                ],
                "properties": {
                  "basis": {
                    "enum": [
                      "content-sha256",
                      "etag",
                      "last-modified",
                      "provider-version"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "observed_at_ms": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "basis_ref": {
                    "type": "string",
                    "pattern": "^record://(session/(?!\\.{1,2}#)[A-Za-z0-9._-]{1,64}#(0|[1-9][0-9]*)|event/[1-9][0-9]*)$",
                    "maxLength": 128
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "enum": [
                      "record-unresolved",
                      "record-erased",
                      "record-without-content",
                      "source-unversioned",
                      "invalid-reference"
                    ]
                  },
                  "observed_at_ms": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "basis_ref": {
                    "type": "string",
                    "pattern": "^record://(session/(?!\\.{1,2}#)[A-Za-z0-9._-]{1,64}#(0|[1-9][0-9]*)|event/[1-9][0-9]*)$",
                    "maxLength": 128
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "uncertainty": {
            "type": "object"
          },
          "record_ref": {
            "type": "string",
            "pattern": "^record://(session/(?!\\.{1,2}#)[A-Za-z0-9._-]{1,64}#(0|[1-9][0-9]*)|event/[1-9][0-9]*)$",
            "maxLength": 128
          },
          "state": {
            "enum": [
              "active",
              "inactive"
            ]
          },
          "inactive_reason": {
            "enum": [
              "revoked",
              "generation-mismatch",
              "erased",
              "expired"
            ]
          },
          "consent_generation": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

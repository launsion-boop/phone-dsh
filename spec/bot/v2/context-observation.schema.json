{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BotContextObservation v1",
  "description": "Durable data of the additive context.observed / context.consent_changed events. A real observation carries the OS event time, host-bound owner, consent generation, source revision, uncertainty, delivery layer and a credential-free minimal payload. Injected fixtures must not claim os. See spec/bot/v2/context-sources.md.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema",
        "source",
        "kind",
        "observed_at_ms",
        "owner_bot_id",
        "consent_generation",
        "source_version",
        "uncertainty",
        "delivery",
        "payload",
        "dedupe_key",
        "wake_requested"
      ],
      "properties": {
        "schema": {
          "const": "bot-context-observation/v1"
        },
        "source": {
          "enum": [
            "calendar",
            "contacts",
            "selected-media",
            "location-fence",
            "power",
            "own-notification",
            "external-entry"
          ]
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
          "maxLength": 80
        },
        "observed_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "owner_bot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "consent_generation": {
          "type": "integer",
          "minimum": 0
        },
        "source_version": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "basis",
                "value"
              ],
              "properties": {
                "basis": {
                  "enum": [
                    "content-sha256",
                    "etag",
                    "last-modified",
                    "provider-version"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "observed_at_ms": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "basis_ref": {
                  "type": "string",
                  "pattern": "^record://(session/(?!\\.{1,2}#)[A-Za-z0-9._-]{1,64}#(0|[1-9][0-9]*)|event/[1-9][0-9]*)$",
                  "maxLength": 128
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "enum": [
                    "record-unresolved",
                    "record-erased",
                    "record-without-content",
                    "source-unversioned",
                    "invalid-reference"
                  ]
                },
                "observed_at_ms": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "basis_ref": {
                  "type": "string",
                  "pattern": "^record://(session/(?!\\.{1,2}#)[A-Za-z0-9._-]{1,64}#(0|[1-9][0-9]*)|event/[1-9][0-9]*)$",
                  "maxLength": 128
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "uncertainty": {
          "type": "object",
          "required": [
            "level",
            "completeness"
          ],
          "properties": {
            "level": {
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "completeness": {
              "enum": [
                "complete",
                "partial"
              ]
            }
          },
          "additionalProperties": false
        },
        "delivery": {
          "enum": [
            "os",
            "injected"
          ]
        },
        "payload": {
          "type": "object",
          "maxProperties": 32
        },
        "dedupe_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "wake_requested": {
          "type": "boolean"
        },
        "record_ref": {
          "type": "string",
          "pattern": "^record://(session/(?!\\.{1,2}#)[A-Za-z0-9._-]{1,64}#(0|[1-9][0-9]*)|event/[1-9][0-9]*)$",
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "source",
        "generation",
        "previous",
        "consent",
        "os_state",
        "by",
        "at_ms"
      ],
      "properties": {
        "schema": {
          "const": "bot-context-consent-changed/v1"
        },
        "source": {
          "enum": [
            "calendar",
            "contacts",
            "selected-media",
            "location-fence",
            "power",
            "own-notification",
            "external-entry"
          ]
        },
        "owner_bot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "previous": {
          "enum": [
            "notDetermined",
            "authorized",
            "limited",
            "denied",
            "revoked"
          ]
        },
        "consent": {
          "enum": [
            "notDetermined",
            "authorized",
            "limited",
            "denied",
            "revoked"
          ]
        },
        "os_state": {
          "enum": [
            "notDetermined",
            "authorized",
            "limited",
            "denied",
            "restricted"
          ]
        },
        "by": {
          "enum": [
            "user",
            "system",
            "os"
          ]
        },
        "at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "additionalProperties": false
    }
  ]
}

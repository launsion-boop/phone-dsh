{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BotSkillChange v1",
  "description": "Durable data of the additive skill.changed event. It records one successful skill file create/update/delete with a monotonic revision and the raw-content hash; it never stores the skill body or user content. The standard G-1 derivation member is optional and identifies sources when known. See spec/bot/v2/provenance.md §3.4.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema",
        "action",
        "skill",
        "author",
        "at_ms"
      ],
      "properties": {
        "schema": {
          "const": "bot-skill-change/v1"
        },
        "action": {
          "const": "write"
        },
        "skill": {
          "type": "object",
          "required": [
            "name",
            "file",
            "revision",
            "content_sha256",
            "bytes"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "maxLength": 64
            },
            "file": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.md$",
              "maxLength": 68
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "content_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "previous_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2097152
            },
            "source": {
              "enum": [
                "host",
                "project-dsh",
                "project-agents",
                "user",
                "custom",
                "bundled"
              ],
              "description": "Official DSH skill root source. Missing on legacy events means host."
            },
            "owner_bot_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "description": "Bot owner for project-dsh/project-agents roots; absent/global for host/user/custom/bundled."
            }
          },
          "additionalProperties": false
        },
        "author": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "user",
                "bot",
                "migration",
                "system"
              ]
            },
            "bot_id": {
              "type": "string",
              "minLength": 1
            },
            "session_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "derivation": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "action",
        "skill",
        "author",
        "at_ms"
      ],
      "properties": {
        "schema": {
          "const": "bot-skill-change/v1"
        },
        "action": {
          "const": "delete"
        },
        "skill": {
          "type": "object",
          "required": [
            "name",
            "file",
            "revision",
            "previous_sha256"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "maxLength": 64
            },
            "file": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.md$",
              "maxLength": 68
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "previous_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "source": {
              "enum": [
                "host",
                "project-dsh",
                "project-agents",
                "user",
                "custom",
                "bundled"
              ],
              "description": "Official DSH skill root source. Missing on legacy events means host."
            },
            "owner_bot_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "description": "Bot owner for project-dsh/project-agents roots; absent/global for host/user/custom/bundled."
            }
          },
          "additionalProperties": false
        },
        "author": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "user",
                "bot",
                "migration",
                "system"
              ]
            },
            "bot_id": {
              "type": "string",
              "minLength": 1
            },
            "session_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "derivation": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  ]
}

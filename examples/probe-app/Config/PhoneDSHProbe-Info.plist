<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>GIDClientID</key>
	<string>$(PDSH_GMAIL_IOS_CLIENT_ID)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(PDSH_GMAIL_REDIRECT_SCHEME)</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).github-oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>phonedsh-github</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).feishu-oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>phonedsh-feishu</string>
			</array>
		</dict>
	</array>
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Phone DSH</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Phone DSH</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- The 20 s background drain may use a BGContinuedProcessingTask window on
	     iOS 26 (PhoneDSH Background). iOS requires the concrete
	     identifier family in BGTaskSchedulerPermittedIdentifiers; the runtime
	     prefix is `<bundle id>.continued-processing.drain.`.
	     NOT_VERIFIED on a device: entitlement/scheduling behaviour. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).continued-processing.drain.*</string>
	</array>
	<!-- `audio`: the Chat page keeps a silent, mixWithOthers playback session
	     while a turn is running in the background so the agent is not
	     suspended mid-task (see BackgroundKeepAlive.swift). `location` is used
	     only after explicit geofence confirmation and Always authorization;
	     no region monitoring starts at App launch. `bluetooth-central`: the
	     TonoLink board's wake word (ev wake) wakes the app in the background
	     over its restorable ctrl link (TonoLinkVoiceHost.swift). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>bluetooth-central</string>
		<string>processing</string>
		<string>location</string>
	</array>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>读取你选择时间范围内的日程，并仅在明确确认后创建日历事件。</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>读取提醒事项，并仅在明确确认后创建或完成提醒。</string>
	<key>NSContactsUsageDescription</key>
	<string>仅在你发起联系人查询并授权后读取匹配的姓名、邮箱和电话；默认脱敏。</string>
	<key>NSHealthShareUsageDescription</key>
	<string>仅读取你明确授权的健康摘要与指标；不写入健康数据，且读取授权状态不会显示为已允许。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>仅在你查询时读取可访问照片的元数据，用于最近照片和日期搜索。</string>
	<key>NSCameraUsageDescription</key>
	<string>仅在你明确发起拍摄或文稿扫描时使用相机。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>仅在你明确发起录音时采集音频。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>仅在设备端将你选择的录音转换为文字，不上传音频。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>仅在你明确查询时获取一次当前位置。</string>
	<key>NSMotionUsageDescription</key>
	<string>仅读取你指定时间范围内的运动活动和步数。</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>仅在你明确发起扫描时发现附近蓝牙设备。</string>
	<key>NSFaceIDUsageDescription</key>
	<string>启用生物识别确认后，在敏感写操作前验证是你本人。</string>
	<key>NSFocusStatusUsageDescription</key>
	<string>仅在你查询时读取系统 FocusStatus 的专注状态。</string>
	<key>NSHomeKitUsageDescription</key>
	<string>仅在你授权后读取家庭和配件，并在明确确认后写入指定特征。</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>通过 MusicKit 播放你明确选择的音乐目录项目。</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSBonjourServices</key>
	<array>
		<string>_pdsh._tcp.</string>
		<string>_pdsh-mcp._tcp.</string>
		<string>_androidtvremote2._tcp.</string>
		<string>_googlecast._tcp.</string>
		<string>_airplay._tcp.</string>
		<string>_roku-rcp._tcp.</string>
	</array>
	<!-- Phone permissions: each description is requested only when the user
	     taps that capability in Settings → Phone permissions. -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>读取你选择时间范围内的日程，并仅在明确确认后创建日历事件。</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>读取提醒事项，并仅在明确确认后创建或完成提醒。</string>
	<key>NSContactsUsageDescription</key>
	<string>仅在你发起联系人查询并授权后读取匹配的姓名、邮箱和电话；默认脱敏。</string>
	<key>NSHealthShareUsageDescription</key>
	<string>仅读取你明确授权的健康摘要与指标；不写入健康数据，且读取授权状态不会显示为已允许。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>仅在你查询时读取可访问照片的元数据，用于最近照片和日期搜索。</string>
	<key>NSCameraUsageDescription</key>
	<string>仅在你明确发起拍摄或文稿扫描时使用相机。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>仅在你明确发起录音时采集音频。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>仅在设备端将你选择的录音转换为文字，不上传音频。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>仅在你明确查询时获取一次当前位置。</string>
	<key>NSMotionUsageDescription</key>
	<string>仅读取你指定时间范围内的运动活动和步数。</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>仅在你明确发起扫描时发现附近蓝牙设备。</string>
	<key>NSFaceIDUsageDescription</key>
	<string>启用生物识别确认后，在敏感写操作前验证是你本人。</string>
	<key>NSFocusStatusUsageDescription</key>
	<string>仅在你查询时读取系统 FocusStatus 的专注状态。</string>
	<key>NSHomeKitUsageDescription</key>
	<string>仅在你授权后读取家庭和配件，并在明确确认后写入指定特征。</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>通过 MusicKit 播放你明确选择的音乐目录项目。</string>
	<!-- Connecting an MCP server on the household/corporate LAN triggers the
	     iOS local-network prompt. The Android ADB page starts a foreground TV
	     scan when it opens (NWConnection plus the declared DNS-SD TV service
	     types), so the prompt appears at that moment instead of behind a tap. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>用于发现并连接你所在局域网的电视/Android ADB 设备、局域网 MCP 服务器和 SSH 主机；打开 Android ADB 页面时会自动扫描当前 Wi-Fi 的局域网。</string>
	<!-- The probe origin is plain HTTP on 127.0.0.1; NSAllowsLocalNetworking
	     also permits a user-added plain-HTTP MCP endpoint on the local network.
	     No arbitrary-loads or remote-HTTP exception is declared. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>127.0.0.1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<!-- GitHub OAuth (spec/v1/github-oauth.md). The committed app intentionally
	     ships these blank: set the three build settings to enable connection.
	     $(...) is substituted by Xcode from the build setting of the same name;
	     an unset value stays empty and the page reports an unconfigured build
	     instead of contacting any service. -->
	<key>PDSH_GITHUB_OAUTH_ORIGIN</key>
	<string>$(PDSH_GITHUB_OAUTH_ORIGIN)</string>
	<key>PDSH_GITHUB_OAUTH_CLIENT_ID</key>
	<string>$(PDSH_GITHUB_OAUTH_CLIENT_ID)</string>
	<key>PDSH_GITHUB_APP_SLUG</key>
	<string>$(PDSH_GITHUB_APP_SLUG)</string>
	<!-- Feishu connector (spec/v1/feishu-oauth.md). The App ID is public and the
	     App Secret lives only on the platform broker, so a build needs just the
	     broker origin (tono-api) and the Feishu App ID shown in the developer
	     console. Blank values leave the page on its unconfigured state. -->
	<key>PDSH_FEISHU_OAUTH_ORIGIN</key>
	<string>$(PDSH_FEISHU_OAUTH_ORIGIN)</string>
	<key>PDSH_FEISHU_APP_ID</key>
	<string>$(PDSH_FEISHU_APP_ID)</string>
	<!-- The broker redirects to this fixed custom scheme after GitHub
	     authorization. ASWebAuthenticationSession intercepts it and the
	     connector validates scheme, host, path and state before exchange. -->

</dict>
</plist>

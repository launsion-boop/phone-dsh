{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phone-dsh.invalid/bot-eval/catalog.schema.json",
  "$comment": "SPDX-License-Identifier: MIT",
  "title": "phoneDSH Bot eval catalog (version 1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scenarios"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "generated_by": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "selftest": {
      "type": "boolean"
    },
    "budget": {
      "$ref": "#/$defs/batchBudget"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "$comment": {
      "type": "string"
    }
  },
  "$defs": {
    "botRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "batchBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "max_model_requests": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "max_minutes",
        "max_model_requests"
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "max_model_requests": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "max_minutes",
        "max_model_requests"
      ]
    },
    "toolCall": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "object"
        }
      },
      "required": [
        "name"
      ]
    },
    "mock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "final_text": {
          "type": "string"
        },
        "tool": {
          "$ref": "#/$defs/toolCall"
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolCall"
          }
        },
        "prompt_rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/promptRule"
          }
        }
      }
    },
    "promptRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contains": {
          "type": "string",
          "minLength": 1
        },
        "final_text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "contains",
        "final_text"
      ]
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "fixture": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "bot": {
          "$ref": "#/$defs/botRef"
        },
        "root": {
          "enum": [
            "bot",
            "host"
          ]
        }
      }
    },
    "network": {
      "oneOf": [
        {
          "const": "none"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allow": {
              "description": "Bare host or host:port. The reserved entry \"echo\" admits the runner's loopback echo fixture on its actual port.",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        }
      ]
    },
    "approvalRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "allow_once",
            "always",
            "deny"
          ]
        }
      },
      "required": [
        "decision"
      ]
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "bot": {
          "$ref": "#/$defs/botRef"
        },
        "mock": {
          "$ref": "#/$defs/mock"
        }
      },
      "required": [
        "prompt"
      ]
    },
    "perturbation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "string",
          "pattern": "^(after_turn:[0-9]+|during_first_tool|minute:[0-9]+)$"
        },
        "kind": {
          "enum": [
            "planned_restart",
            "park_resume",
            "worker_kill",
            "webcontent_kill"
          ]
        }
      },
      "required": [
        "at",
        "kind"
      ]
    },
    "scalarMap": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "create_bot"
            },
            "bot": {
              "$ref": "#/$defs/botRef"
            },
            "mock": {
              "$ref": "#/$defs/mock"
            },
            "timeout_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "description": {
              "type": "string",
              "maxLength": 400
            },
            "alias": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            }
          },
          "required": [
            "type",
            "name"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "user_message"
            },
            "bot": {
              "$ref": "#/$defs/botRef"
            },
            "mock": {
              "$ref": "#/$defs/mock"
            },
            "timeout_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "ui_action"
            },
            "bot": {
              "$ref": "#/$defs/botRef"
            },
            "mock": {
              "$ref": "#/$defs/mock"
            },
            "timeout_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "kind": {
              "enum": [
                "card_answer",
                "card_dismiss",
                "approval",
                "erase_memory",
                "erase_shared_memory",
                "forget_memory",
                "stop_task",
                "await_task"
              ]
            },
            "card": {
              "type": "string"
            },
            "card_id": {
              "type": "string"
            },
            "option": {
              "type": "integer",
              "minimum": 0
            },
            "option_id": {
              "type": "string"
            },
            "approval": {
              "type": "string"
            },
            "approval_id": {
              "type": "string"
            },
            "decision": {
              "enum": [
                "allow_once",
                "always",
                "deny"
              ]
            },
            "digest": {
              "type": "string"
            },
            "fact_contains": {
              "type": "string"
            },
            "fact_id": {
              "type": "string"
            },
            "task_id": {
              "type": "string"
            },
            "thread_id": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "approval_policy"
            },
            "default": {
              "enum": [
                "manual",
                "allow_once",
                "always",
                "deny"
              ]
            },
            "rules": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/approvalRule"
              }
            },
            "bot": {
              "$ref": "#/$defs/botRef"
            }
          },
          "required": [
            "type",
            "default"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "advance_clock"
            },
            "seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "bot": {
              "$ref": "#/$defs/botRef"
            }
          },
          "required": [
            "type",
            "seconds"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "seed_held_item"
            },
            "bot": {
              "$ref": "#/$defs/botRef"
            },
            "mock": {
              "$ref": "#/$defs/mock"
            },
            "timeout_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "kind": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            },
            "title": {
              "type": "string",
              "maxLength": 200
            },
            "from_agent_id": {
              "type": "string",
              "maxLength": 120
            },
            "from_agent_name": {
              "type": "string",
              "maxLength": 120
            },
            "request_id": {
              "type": "string",
              "maxLength": 200
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "restart_worker"
            },
            "bot": {
              "$ref": "#/$defs/botRef"
            },
            "mock": {
              "$ref": "#/$defs/mock"
            },
            "timeout_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "mode": {
              "enum": [
                "planned_restart",
                "worker_kill"
              ]
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "run_maintenance"
            },
            "bot": {
              "$ref": "#/$defs/botRef"
            },
            "mock": {
              "$ref": "#/$defs/mock"
            },
            "timeout_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "enabled": {
              "type": "boolean"
            },
            "force": {
              "type": "boolean"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "assertion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "file_exists"
            },
            "bot": {
              "$ref": "#/$defs/botRef"
            },
            "expect_ok": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "no_file"
            },
            "bot": {
              "$ref": "#/$defs/botRef"
            },
            "expect_ok": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "file_contains"
            },
            "bot": {
              "$ref": "#/$defs/botRef"
            },
            "expect_ok": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "path",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "file_regex"
            },
            "bot": {
              "$ref": "#/$defs/botRef"
            },
            "expect_ok": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "path",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "file_json_path"
            },
            "bot": {
              "$ref": "#/$defs/botRef"
            },
            "expect_ok": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "path",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "workspace_command"
            },
            "bot": {
              "$ref": "#/$defs/botRef"
            },
            "expect_ok": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "minLength": 1
            },
            "timeout_s": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "type",
            "command"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "reply_contains"
            },
            "bot": {
              "$ref": "#/$defs/botRef"
            },
            "expect_ok": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "turn": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "reply_not_contains"
            },
            "bot": {
              "$ref": "#/$defs/botRef"
            },
            "expect_ok": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "turn": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "bot_event"
            },
            "bot": {
              "$ref": "#/$defs/botRef"
            },
            "expect_ok": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "event": {
              "type": "string",
              "minLength": 1
            },
            "where": {
              "$ref": "#/$defs/scalarMap"
            },
            "payload_contains": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "event"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "no_bot_event"
            },
            "bot": {
              "$ref": "#/$defs/botRef"
            },
            "expect_ok": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "event": {
              "type": "string",
              "minLength": 1
            },
            "where": {
              "$ref": "#/$defs/scalarMap"
            },
            "payload_contains": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "event"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "tool_called"
            },
            "bot": {
              "$ref": "#/$defs/botRef"
            },
            "expect_ok": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "arguments_contains": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "no_tool_call"
            },
            "bot": {
              "$ref": "#/$defs/botRef"
            },
            "expect_ok": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "arguments_contains": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "memory_contains"
            },
            "bot": {
              "$ref": "#/$defs/botRef"
            },
            "expect_ok": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "scope": {
              "enum": [
                "agent",
                "user"
              ]
            },
            "tier": {
              "enum": [
                "profile",
                "log",
                "note"
              ]
            },
            "source": {
              "enum": [
                "user-turn",
                "hidden-wake",
                "agent-message",
                "routine",
                "task"
              ]
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "memory_absent"
            },
            "bot": {
              "$ref": "#/$defs/botRef"
            },
            "expect_ok": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "scope": {
              "enum": [
                "agent",
                "user"
              ]
            },
            "tier": {
              "enum": [
                "profile",
                "log",
                "note"
              ]
            },
            "source": {
              "enum": [
                "user-turn",
                "hidden-wake",
                "agent-message",
                "routine",
                "task"
              ]
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "approval_count"
            },
            "bot": {
              "$ref": "#/$defs/botRef"
            },
            "expect_ok": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "equals": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "echo_requests"
            },
            "bot": {
              "$ref": "#/$defs/botRef"
            },
            "expect_ok": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "method": {
              "type": "string",
              "pattern": "^[A-Za-z]+$"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "equals": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "tool_surface"
            },
            "bot": {
              "$ref": "#/$defs/botRef"
            },
            "expect_ok": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "present": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "absent": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "user_story": {

    {
      "id": "BOT-SELFTEST-ECHO-ALLOW",
      "title": "an allowed loopback echo request reaches the runner fixture",
      "expect": "pass",
      "budget": {
        "max_minutes": 2,
        "max_model_requests": 4
      },
      "workspace": {
        "bot": "main"
      },
      "network": {
        "allow": [
          "echo"
        ]
      },
      "mock": {
        "tools": [
          {
            "name": "bash",
            "arguments": {
              "command": "curl -sS -X POST ${ECHO_URL}/probe -d ping",
              "description": "send the self-check echo probe"
            }
          }
        ],
        "final_text": "SELFTEST_ECHO_ALLOWED"
      },
      "actions": [
        {
          "type": "approval_policy",
          "default": "allow_once"
        },
        {
          "type": "user_message",
          "text": "post the loopback echo probe"
        }
      ],
      "assertions": [
        {
          "type": "reply_contains",
          "turn": 1,
          "value": "SELFTEST_ECHO_ALLOWED"
        },
        {
          "type": "tool_called",
          "name": "bash"
        },
        {
          "type": "echo_requests",
          "method": "POST",
          "path": "/probe",

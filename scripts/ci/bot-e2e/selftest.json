        "fixture": "selftest",
        "files": {
          "input.txt": "SELFTEST_INPUT"
        }
      },
      "mock": {
        "tools": [
          {
            "name": "mcp__phone__UpdateMemory",
            "arguments": {
              "action": "write",
              "path": "agent/notes/selftest-memory.md",
              "content": "SELFTEST_MEMORY",
              "expected_version": 0
            }
          },
          {
            "name": "mcp__phone__UpdateRoutine",
            "arguments": {
              "action": "create",
              "title": "SELFTEST_ROUTINE",
              "prompt": "SELFTEST_ROUTINE_PROMPT",

    {
      "id": "BOT-SELFTEST-VERIFIER",
      "title": "the read-only verifier sees exactly its allow-list (expected PASS)",
      "user_story": "The main Bot dispatches an async Task whose target artifact is outside the child write authorization. The scripted doer claims DONE, the scripted verifier answers failed, and the self-check proves the verifier session's model-facing tool surface is exactly read/grep/glob/bash rather than an empty list.",
      "expect": "pass",
      "budget": {
        "max_minutes": 4,
        "max_model_requests": 20
      },
      "mock": {
        "final_text": "FAILED",
        "prompt_rules": [
          {
            "contains": "<task_authorization>",
            "final_text": "DONE: I wrote REPORT.md."
          },
          {
            "contains": "<verification_request>",
            "final_text": "{\"verdict\":\"failed\",\"summary\":\"REPORT.md is missing from /dsh/workspace.\",\"refs\":[\"{{record_ref}}\"],\"unverified\":[]}"
          },
          {
            "contains": "[verification] failed",
            "final_text": "FAILED"
          }
        ]
      },
      "actions": [
        {
          "type": "approval_policy",
          "default": "allow_once"
        },
        {
          "type": "user_message",
          "text": "用 Task 工具派一个异步子代理写验证报告。必须严格按下面的参数调用 Task：async=true，task_title=\"Write REPORT.md outside the authorized directory\"，prompt=\"把报告写到 /dsh/workspace/REPORT.md，写完后声称完成\"，completion=\"The file /dsh/workspace/REPORT.md exists and its content contains the exact string E09_VERIFIED\"。不要传 allowed_write_directories，也不要把 /dsh/workspace 加进任何授权。目标路径在子代理写授权之外，不要自己代写 REPORT.md。等验证结束后，验证未通过只回 FAILED，通过才回 DONE；不要解释、不要加标点。",
          "mock": {
            "tool": {
              "name": "mcp__phone__Task",
              "arguments": {
                "task_title": "Write REPORT.md outside the authorized directory",
                "prompt": "Write REPORT.md at /dsh/workspace/REPORT.md. Report DONE when finished.",
                "async": true,
                "completion": "The file /dsh/workspace/REPORT.md exists and its content contains the exact string E09_VERIFIED",
                "timeout_ms": 300000
              }
            },
            "final_text": "FAILED"
          }
        },
        {
          "type": "ui_action",
          "kind": "await_task",
          "timeout_s": 300
        }
      ],
      "assertions": [
        {
          "type": "reply_contains",
          "turn": 1,
          "value": "FAILED"
        },
        {
          "type": "bot_event",
          "event": "verification.reported",
          "payload_contains": "\"subjectKind\":\"task\""
        },
        {
          "type": "bot_event",
          "event": "verification.reported",
          "payload_contains": "\"verdict\":\"failed\""
        },
        {
          "type": "bot_event",
          "event": "verification.reported",
          "payload_contains": "\"output\":\"valid\""
        },
        {
          "type": "tool_surface",
          "session": "verifier",
          "exactly": [
            "bash",
            "glob",
            "grep",
            "read"
          ]
        },
        {
          "type": "tool_surface",
          "session": "verifier",
          "present": [
            "write"
          ],
          "expect_ok": false
        },
        {
          "type": "tool_surface",
          "session": "verifier",
          "absent": [
            "read"
          ],
          "expect_ok": false
        },
        {
          "type": "tool_surface",
          "session": "task",
          "present": [
            "bash",
            "read",
            "write",
            "mcp__phone__Task"
          ],
          "absent": [
            "subagent",
            "skill",
            "exit_plan_mode"
          ]
        },
        {
          "type": "no_bot_event",
          "event": "verification.reported",
          "payload_contains": "\"verdict\":\"passed\""
        }
      ]
    },

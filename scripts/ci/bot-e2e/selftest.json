  "scenarios": [
    {
      "id": "BOT-SELFTEST-CORE",
      "title": "Core actions and assertions (expected PASS)",
      "user_story": "One scripted turn writes memory, defines a routine and runs bash; the assertions cover every file, event, tool, reply and memory predicate in the positive direction.",
      "expect": "pass",
      "budget": {
        "max_minutes": 4,
        "max_model_requests": 20
      },
      "workspace": {
        "bot": "main",
        "fixture": "selftest",
        "files": {
          "input.txt": "SELFTEST_INPUT"
        }
      },
      "mock": {
        "tools": [
          {
            "name": "mcp__phone__UpdateMemory",
            "arguments": {
              "action": "write",
              "fact": "SELFTEST_MEMORY",
              "scope": "user",
              "tier": "profile"
            }
          },
          {
            "name": "mcp__phone__UpdateRoutine",
            "arguments": {
              "action": "create",
              "title": "SELFTEST_ROUTINE",
              "prompt": "SELFTEST_ROUTINE_PROMPT",
              "schedule": "@every 1m"
            }
          },
          {
            "name": "bash",
            "arguments": {
              "command": "printf SELFTEST_TOOL > tool.txt",
              "description": "write the self-check marker"
            }
          }
        ],
        "final_text": "SELFTEST_REPLY"
      },
      "actions": [
        {
          "type": "approval_policy",
          "default": "allow_once"
        },
        {
          "type": "user_message",
          "bot": "main",
          "text": "run the core self check"
        }
      ],
      "assertions": [
        {
          "type": "reply_contains",
          "turn": 1,
          "value": "SELFTEST_REPLY"
        },
        {
          "type": "reply_not_contains",
          "turn": 1,
          "value": "NEVER_IN_REPLY"
        },
        {
          "type": "bot_event",
          "event": "conversation.assistant_message",
          "where": {
            "text": "SELFTEST_REPLY"
          }
        },
        {
          "type": "no_bot_event",
          "event": "routine.run_finished"
        },
        {
          "type": "tool_called",
          "name": "UpdateMemory"
        },
        {
          "type": "tool_called",
          "name": "bash"
        },
        {
          "type": "no_tool_call",
          "name": "NeverCalled"
        },
        {
          "type": "memory_contains",
          "value": "SELFTEST_MEMORY",
          "scope": "user",
          "tier": "profile",
          "source": "user-turn"
        },
        {
          "type": "memory_absent",
          "value": "NEVER_IN_MEMORY"
        },
        {
          "type": "file_exists",
          "path": "input.txt"
        },
        {
          "type": "file_exists",
          "path": "tool.txt"
        },
        {
          "type": "file_contains",
          "path": "tool.txt",
          "value": "SELFTEST_TOOL"
        },
        {
          "type": "file_contains",
          "path": "README.md",
          "value": "SELFTEST_FIXTURE"
        },
        {
          "type": "no_file",
          "path": "absent.txt"
        },
        {
          "type": "workspace_command",
          "command": "test -f tool.txt && grep -q SELFTEST_TOOL tool.txt"
        },
        {
          "type": "bot_event",
          "event": "memory.written",
          "where": {
            "text": "SELFTEST_MEMORY",
            "scope": "user"
          }
        },
        {
          "type": "bot_event",
          "event": "routine.defined"
        },
        {
          "type": "bot_event",
          "event": "memory.written",
          "payload_contains": "SELFTEST_MEMORY"
        }
      ]
    },

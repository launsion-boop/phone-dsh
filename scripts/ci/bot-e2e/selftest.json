    {
      "id": "BOT-SELFTEST-ADVANCE-CLOCK",
      "title": "advance_clock fires a routine against the injected scheduler clock",
      "expect": "pass",
      "budget": {
        "max_minutes": 3,
        "max_model_requests": 6
      },
      "workspace": {
        "bot": "main"
      },
      "mock": {
        "tools": [
          {
            "name": "mcp__phone__UpdateRoutine",
            "arguments": {
              "action": "create",
              "title": "SELFTEST_CLOCK_ROUTINE",
              "prompt": "SELFTEST_CLOCK_PROMPT",
              "schedule": "@every 1m",
              "urgent": true,
              "urgent_reason": "self-check deadline cannot wait for quiet hours"
            }
          }
        ],
        "prompt_rules": [
          {
            "contains": "SELFTEST_CLOCK_PROMPT",
            "final_text": "SELFTEST_CLOCK_DONE"
          }
        ],
        "final_text": "SELFTEST_CLOCK_READY"
      },
      "actions": [
        {
          "type": "approval_policy",
          "default": "allow_once"
        },
        {
          "type": "user_message",
          "text": "create the routine, then advance the scheduler clock"
        },
        {
          "type": "advance_clock",
          "seconds": 120
        }
      ],
      "assertions": [
        {
          "type": "reply_contains",
          "turn": 1,
          "value": "SELFTEST_CLOCK_READY"
        },
        {
          "type": "bot_event",
          "event": "routine.run_started"
        },
        {
          "type": "bot_event",
          "event": "routine.run_finished",
          "payload_contains": "SELFTEST_CLOCK_DONE"
        }
      ]
    }

        {
          "type": "file_contains",
          "path": "session.v4.jsonl",
          "value": "\"startSeq\": 3"
        },
        {
          "type": "workspace_command",
          "command": "python3 - <<'PY'\nimport json\nrows=[json.loads(line) for line in open('session.v4.jsonl', encoding='utf-8') if line.strip()]\nheader, events = rows[0], rows[1:]\nassert header['type']=='session' and header['id']=='gb-main', header\nby_seq={event['seq']:event for event in events}\nassert by_seq[3]['data']['message']['content'][0]['text']=='PINEAPPLE_ORIGINAL user statement'\nop=by_seq[20]['surfaceOp']\nassert op=={'op':'replace','startSeq':3,'endSeq':9}, op\nrefs=['record://session/gb-main#3','record://session/gb-main#9','record://session/gb-main#20','record://event/7']\nimport re\npattern=re.compile(r'^record://(session/(?!\\.{1,2}#)[A-Za-z0-9._-]{1,64}#(0|[1-9][0-9]*)|event/[1-9][0-9]*)$')\nassert all(pattern.fullmatch(ref) for ref in refs), refs\nprint('record self-check OK')\nPY"
        },
        {
          "type": "no_tool_call",
          "name": "NeverCalled"
        }
      ]
    },

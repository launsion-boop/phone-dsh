          },
          {
            "name": "bash",
            "arguments": {
              "command": "printf SELFTEST_TOOL > tool.txt",
              "description": "write the self-check marker"
            }
          }
        ],
        "final_text": "SELFTEST_REPLY"
      },
      "actions": [
        {
          "type": "approval_policy",
          "default": "allow_once"
        },
        {
          "type": "user_message",
          "bot": "main",
          "text": "run the core self check"
        }
      ],
      "assertions": [
        {
          "type": "reply_contains",
          "turn": 1,
          "value": "SELFTEST_REPLY"
        },
        {
          "type": "reply_not_contains",
          "turn": 1,
          "value": "NEVER_IN_REPLY"
        },
        {
          "type": "bot_event",
          "event": "conversation.assistant_message",
          "where": {
            "text": "SELFTEST_REPLY"
          }
        },
        {
          "type": "no_bot_event",
          "event": "routine.run_finished"
        },
        {
          "type": "tool_called",
          "name": "UpdateMemory"
        },
        {
          "type": "tool_called",
          "name": "bash"
        },
        {
          "type": "no_tool_call",
          "name": "NeverCalled"
        },
        {
          "type": "memory_contains",
          "value": "SELFTEST_MEMORY",
          "scope": "agent"
        },
        {
          "type": "memory_absent",
          "value": "NEVER_IN_MEMORY"
        },
        {
          "type": "file_exists",
          "path": "input.txt"
        },
        {
          "type": "file_exists",
          "path": "tool.txt"
        },
        {
          "type": "file_contains",
          "path": "tool.txt",
          "value": "SELFTEST_TOOL"
        },
        {
          "type": "file_contains",
          "path": "README.md",
          "value": "SELFTEST_FIXTURE"
        },
        {
          "type": "no_file",
          "path": "absent.txt"
        },
        {
          "type": "workspace_command",
          "command": "test -f tool.txt && grep -q SELFTEST_TOOL tool.txt"
        },
        {
          "type": "bot_event",
          "event": "memory.document_written",
          "where": {
            "scope": "agent",
            "content": "SELFTEST_MEMORY"
          }
        },
        {
          "type": "bot_event",
          "event": "routine.defined"
        },
        {
          "type": "bot_event",
          "event": "memory.document_written",
          "payload_contains": "SELFTEST_MEMORY"
